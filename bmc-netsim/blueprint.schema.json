{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint",
  "description": "A run: the device instances to bring up.",
  "type": "object",
  "properties": {
    "instances": {
      "description": "Each entry instantiates one device `count` times.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Instance"
      }
    }
  },
  "required": [
    "instances"
  ],
  "$defs": {
    "AxeosParams": {
      "description": "Tunables for a simulated AxeOS miner.",
      "type": "object",
      "properties": {
        "hashrate_ths": {
          "description": "Current hashrate to hover around, in TH/s.",
          "$ref": "#/$defs/NonNegative"
        },
        "model_name": {
          "description": "Model name reported as `deviceModel`.",
          "type": "string",
          "default": "NerdQAxe++"
        },
        "nominal_ths": {
          "description": "Nameplate (expected) hashrate at current settings, in TH/s.",
          "$ref": "#/$defs/NonNegative"
        },
        "power_w": {
          "description": "Power draw to hover around, in W.",
          "$ref": "#/$defs/NonNegative"
        },
        "status": {
          "description": "HTTP status the telemetry endpoint returns (503 = present, unreadable).",
          "$ref": "#/$defs/HttpStatus"
        },
        "temp_c": {
          "description": "Temperature to hover around, in °C.",
          "$ref": "#/$defs/Celsius"
        },
        "uptime_s": {
          "description": "Reported uptime, in seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 187020,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "BosParams": {
      "description": "Tunables for a simulated BOS+ miner.",
      "type": "object",
      "properties": {
        "auth_status": {
          "description": "HTTP status the login endpoint returns; 401 = the miner needs credentials\nthe widget doesn't have, so it never authenticates (the no-creds case).",
          "$ref": "#/$defs/HttpStatus"
        },
        "hashrate_ths": {
          "description": "Current hashrate to hover around, in TH/s (low value = not-okay).",
          "$ref": "#/$defs/NonNegative"
        },
        "model_name": {
          "description": "Model name reported on `/miner/details`.",
          "type": "string",
          "default": "Braiins Mini Miner BMM 101"
        },
        "nominal_ths": {
          "description": "Nameplate (`sticker_hashrate`) hashrate, in TH/s.",
          "$ref": "#/$defs/NonNegative"
        },
        "power_w": {
          "description": "Power draw to hover around, in W.",
          "$ref": "#/$defs/NonNegative"
        },
        "status": {
          "description": "HTTP status the telemetry endpoints return (503 = present, unreadable).",
          "$ref": "#/$defs/HttpStatus"
        },
        "temp_c": {
          "description": "Junction temperature to hover around, in °C.",
          "$ref": "#/$defs/Celsius"
        },
        "uptime_s": {
          "description": "Reported uptime, in seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 187020,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "BraiinsPoolParams": {
      "description": "Tunables for a simulated Braiins Pool account.",
      "type": "object",
      "properties": {
        "hashrate_ths": {
          "description": "5-minute-average hashrate the account hovers around, in TH/s.",
          "$ref": "#/$defs/NonNegative"
        },
        "payout_amount_btc": {
          "description": "Amount of every completed payout, in BTC.",
          "$ref": "#/$defs/NonNegative"
        },
        "payout_period_s": {
          "description": "Seconds between payouts, landing on the unix-epoch grid (86400 =\ndaily at midnight UTC). `null` = an account that has never paid out:\nno history, no estimate, null progress.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": 86400,
          "minimum": 1
        },
        "reward_btc": {
          "description": "Today's reward estimate, in BTC.",
          "$ref": "#/$defs/NonNegative"
        },
        "reward_usd": {
          "description": "The same estimate in USD.",
          "$ref": "#/$defs/NonNegative"
        },
        "status": {
          "description": "HTTP status every endpoint returns; 401/403 = the denied account.",
          "$ref": "#/$defs/HttpStatus"
        },
        "workers_active": {
          "description": "Worker counts by state, as `/user/workers/current` reports them.",
          "type": "integer",
          "format": "uint64",
          "default": 24,
          "minimum": 0
        },
        "workers_disabled": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "workers_low": {
          "type": "integer",
          "format": "uint64",
          "default": 2,
          "minimum": 0
        },
        "workers_offline": {
          "type": "integer",
          "format": "uint64",
          "default": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Celsius": {
      "description": "A temperature in degrees Celsius, above absolute zero",
      "type": "number",
      "exclusiveMinimum": -273.15
    },
    "HttpStatus": {
      "description": "HTTP status this endpoint returns, e.g. 200, 401 or 503",
      "type": "integer",
      "enum": [
        100,
        101,
        102,
        200,
        201,
        202,
        203,
        204,
        205,
        206,
        207,
        208,
        226,
        300,
        301,
        302,
        303,
        304,
        305,
        307,
        308,
        400,
        401,
        402,
        403,
        404,
        405,
        406,
        407,
        408,
        409,
        410,
        411,
        412,
        413,
        414,
        415,
        416,
        417,
        418,
        421,
        422,
        423,
        424,
        425,
        426,
        428,
        429,
        431,
        451,
        500,
        501,
        502,
        503,
        504,
        505,
        506,
        507,
        508,
        510,
        511
      ]
    },
    "Instance": {
      "description": "One device instance, discriminated by `device`\nand carrying that device's typed params.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint",
              "default": 1,
              "minimum": 0
            },
            "device": {
              "type": "string",
              "const": "bos"
            },
            "label": {
              "description": "Human label describing this entry's scenario, shown in the readout.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "params": {
              "$ref": "#/$defs/BosParams"
            }
          },
          "required": [
            "device"
          ]
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint",
              "default": 1,
              "minimum": 0
            },
            "device": {
              "type": "string",
              "const": "bos-libre"
            },
            "label": {
              "description": "Human label describing this entry's scenario, shown in the readout.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "params": {
              "$ref": "#/$defs/UbosParams"
            }
          },
          "required": [
            "device"
          ]
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint",
              "default": 1,
              "minimum": 0
            },
            "device": {
              "type": "string",
              "const": "axeos"
            },
            "label": {
              "description": "Human label describing this entry's scenario, shown in the readout.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "params": {
              "$ref": "#/$defs/AxeosParams"
            }
          },
          "required": [
            "device"
          ]
        },
        {
          "description": "A Braiins Pool account — a cloud API on its port, never announced.",
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint",
              "default": 1,
              "minimum": 0
            },
            "device": {
              "type": "string",
              "const": "braiins-pool"
            },
            "label": {
              "description": "Human label describing this entry's scenario, shown in the readout.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "params": {
              "$ref": "#/$defs/BraiinsPoolParams"
            }
          },
          "required": [
            "device"
          ]
        }
      ]
    },
    "NonNegative": {
      "description": "A non-negative figure, such as a hashrate or a power draw",
      "type": "number",
      "minimum": 0.0
    },
    "UbosParams": {
      "description": "Tunables for a simulated Braiins Forge Miner x4 (Braiins OS Libre).",
      "type": "object",
      "properties": {
        "hashrate_ths": {
          "description": "Current hashrate to hover around, in TH/s.",
          "$ref": "#/$defs/NonNegative"
        },
        "model_name": {
          "description": "Product name reported on `/api/info`.",
          "type": "string",
          "default": "Braiins Forge Miner x4"
        },
        "power_w": {
          "description": "Power draw to hover around, in W.",
          "$ref": "#/$defs/NonNegative"
        },
        "status": {
          "description": "HTTP status the telemetry endpoint returns (503 = present, unreadable).",
          "$ref": "#/$defs/HttpStatus"
        },
        "temp_c": {
          "description": "Temperature to hover around, in °C.",
          "$ref": "#/$defs/Celsius"
        },
        "uptime_s": {
          "description": "Reported uptime, in seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 187020,
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
