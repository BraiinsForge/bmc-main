# bmc-netsim dev tasks — local-iteration shortcuts around the simulator binary.

dir := source_directory()

[private]
default:
    @just --justfile {{ source_file() }} --list

# Regenerate the committed blueprint JSON schema from the Rust types.
schema:
    UPDATE_SCHEMA=1 cargo test -p bmc-netsim blueprint_schema

# Run the simulator: a bare name from blueprints/ (default example), or a path to any .json5.
run blueprint="example":
    #!/usr/bin/env bash
    set -euo pipefail

    bp="{{ blueprint }}"
    [[ "$bp" == *.json5 ]] || bp="{{ dir }}/blueprints/$bp.json5"

    exec cargo run -p bmc-netsim -- run "$bp"
