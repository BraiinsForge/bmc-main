{
  "$schema": "../blueprint.schema.json",

  // Braiins Pool accounts for the braiins-pool widget. Cloud APIs: nothing
  // is announced — point the testbed at a port with
  //   just wasm::dev braiins-pool "--secrets ../secrets.local.json
  //     --rewrite-url https://api.braiins.com=http://127.0.0.1:20000"
  // and put `"allow_hosts": ["127.0.0.0/8"]` beside the slot's dummy token
  // in the secrets file so the egress pin admits the loopback ports.
  //
  // Ports follow blueprint order: 20000 healthy, 20001 idle, 20002 denied.
  //
  // Run with `just netsim::run pool`.
  instances: [
    {
        device: "braiins-pool",
        label: "Healthy FPPS account — daily payouts, ~500 TH/s",
    },
    {
        device: "braiins-pool",
        label: "Idle account — zeros everywhere, no payout ever",
        params: {
            hashrate_ths: 0,
            workers_active: 0,
            workers_low: 0,
            workers_offline: 0,
            reward_btc: 0,
            reward_usd: 0,
            payout_period_s: 0,
        },
    },
    {
        device: "braiins-pool",
        label: "Denied account — the API refuses the key",
        params: { status: 403 },
    },
  ],
}
