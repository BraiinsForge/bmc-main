{
  "$schema": "../blueprint.schema.json",

  // BOS miners whose login returns 401. With an empty `bos_password` in the
  // widget, the poller can never authenticate, so these stay unconfirmed and
  // invisible and the fleet reads empty — the exact state the no-credentials
  // scene is built for. The fleet is BOS-only on purpose: any delivering
  // uBOS/AxeOS would fill the dashboard and pre-empt the empty-state scene.
  //
  // Run with `just netsim::run no-credentials`, and leave `bos_password` empty
  // in the widget config.
  instances: [
    {
        count: 6,
        device: "bos",
        label: "BMM 101 that requires credentials → login 401s",
        params: { auth_status: 401 }
    },
  ],
}
