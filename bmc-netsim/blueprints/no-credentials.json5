{
  "$schema": "../blueprint.schema.json",

  // BOS miners whose login returns 401, so no account ever authenticates.
  // With the widget's BOS miners slot bound they read "Login rejected";
  // left unbound they are never polled and read "Check account".
  // The fleet is BOS-only on purpose, so no other family fills the dashboard.
  //
  // Run with `just netsim::run no-credentials`.
  instances: [
    {
        count: 6,
        device: "bos",
        label: "Braiins Mini Miner BMM 101 that requires credentials → login 401s",
        params: { auth_status: 401 }
    },
  ],
}
