import { Palette } from "../style/palette.slint";
import { SoundAdapter, BrightnessAdapter } from "../controls/adapters.slint";
import { NightModeAdapter, WifiReconfigAdapter } from "../controls/adapters.slint";
import { ConnectionAdapter, WifiAdapter } from "../controls/adapters.slint";
import { Images } from "../style/images.slint";
import { Theme } from "../style/theme.slint";
import { CircleIcon } from "./circle-icon.slint";
import { LongPressCircleIcon } from "./long-press-circle-icon.slint";
import { WifiIndicator } from "./wifi-indicator.slint";

export component BottomRollette inherits Rectangle {
    property <length> handle_size: 50px;
    property <length> open_close_delta: 20px;
    property <bool> dragging: false;
    property <length> initial_y: 0px;  // Initial Y position when touch starts
    property <length> current_y: 0px;  // Current Y position during drag
    property <length> initial_offset: 0px;  // Offset when touch started
    property <length> offset: 0px;
    property <length> temp_offset: 0px;
    property <string> ip <=> ConnectionAdapter.ip;
    property <image> ip_qr_code <=> ConnectionAdapter.ip_qr_code;

    callback restart();

    TouchArea {
        width: parent.width;
        height: root.dragging ? (root.offset + root.handle_size) : (root.offset == 0px) ? root.handle_size : parent.height;
        y: root.dragging ? (parent.height - root.offset - root.handle_size) : (root.offset == 0px) ? (parent.height - root.handle_size) : 0px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.initial_y = self.mouse-y + self.y;
                root.current_y = self.mouse-y + self.y;
                root.initial_offset = root.offset;
                root.dragging = true;
            }
            if (event.kind == PointerEventKind.move && root.dragging) {
                // Use absolute Y position (mouse-y + TouchArea's y offset)
                root.current_y = self.mouse-y + self.y;
                root.temp_offset = root.initial_offset + (root.initial_y - root.current_y);

                if (root.temp_offset < 0px) {
                    root.temp_offset = 0px;
                } else if (root.temp_offset > root.height) {
                    root.temp_offset = root.height;
                }
                root.offset = root.temp_offset;
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;

                // Calculate total distance dragged from initial touch position
                root.temp_offset = root.initial_y - root.current_y;

                // Only change state if dragged more than open_close_delta
                if (abs(root.temp_offset) >= root.open_close_delta) {
                    // Dragged up (negative Y direction = opening)
                    if (root.temp_offset > 0px) {
                        debug("UP: Dragged up enough, opening");
                        root.offset = root.height;
                    }
                    // Dragged down (positive Y direction = closing)
                    else {
                        root.offset = 0px;
                    }
                } else {
                    // Not enough drag, restore to initial state
                    root.offset = root.initial_offset;
                }
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        y: parent.height - root.offset;
        background: rgba(0, 0, 0, 0.95);

        VerticalLayout {
            padding-top: 33px;
            padding-left: 32px;
            padding-right: 106px;
            padding-bottom: 32px;
            spacing: 100px;

            // Top section - QR code and IP/WiFi info
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 24px;
                    Rectangle {
                        background: Palette.white;
                        width: 106px;
                        height: 106px;
                        border-radius: 4px;

                        Image {
                            source: ip_qr_code;
                            width: 90px;
                            height: 90px;
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        Text {
                            text: "IP Address";
                            color: Palette.gray-50;
                            font-size: 16px;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                        }

                        Text {
                            text: ConnectionAdapter.ip;
                            color: Palette.white;
                            font-size: 24px;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    Text {
                        text: "WiFi Connection";
                        color: Palette.gray-40;
                        font-size: 16px;
                        horizontal-alignment: left;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 16px;

                        WifiIndicator {
                            signal: WifiAdapter.signal_strength;
                        }

                        Text {
                            text: WifiAdapter.ssid;
                            color: Palette.white;
                            font-size: 24px;
                            horizontal-alignment: left;
                            wrap: no-wrap;
                        }
                    }
                }
            }

            // Bottom section - circle controls
            HorizontalLayout {
                padding-left: 60px;
                padding-right: 40px;
                spacing: 40px;

                VerticalLayout {
                    HorizontalLayout {
                        spacing: 12px;
                        CircleIcon {
                            icon_source: Images.sound-low;
                            clicked => {
                                SoundAdapter.volume_decrease();
                            }
                        }

                        CircleIcon {
                            icon_source: Images.sound-high;
                            clicked => {
                                SoundAdapter.volume_increase();
                            }
                        }
                    }

                    Rectangle {
                        height: 24px;
                    }

                    Rectangle {
                        height: 31px;
                        Text {
                            text: SoundAdapter.volume;
                            color: Palette.white;
                            font-weight: Theme.font.weight.bold;
                            font-size: 24px;
                        }
                    }

                    Rectangle {
                        Text {
                            text: "Volume";
                            color: Palette.gray-50;
                            font-size: 24px;
                        }
                    }
                }

                VerticalLayout {
                    HorizontalLayout {
                        spacing: 12px;
                        CircleIcon {
                            icon_source: Images.brightness-low;
                            clicked => {
                                BrightnessAdapter.brightness_decrease();
                            }
                        }

                        CircleIcon {
                            icon_source: Images.brightness-high;
                            clicked => {
                                BrightnessAdapter.brightness_increase();
                            }
                        }
                    }

                    Rectangle {
                        height: 24px;
                    }

                    Rectangle {
                        height: 31px;
                        Text {
                            text: BrightnessAdapter.brightness;
                            color: Palette.white;
                            font-weight: Theme.font.weight.bold;
                            font-size: 24px;
                        }
                    }

                    Rectangle {
                        Text {
                            text: "Brightness";
                            color: Palette.gray-50;
                            font-size: 24px;
                        }
                    }
                }

                VerticalLayout {
                    HorizontalLayout {
                        alignment: center;

                        CircleIcon {
                            icon_source: Images.nightmode;
                            circle_color: NightModeAdapter.is-active ? Palette.blue-70 : rgba(255, 255, 255, 0.30);
                            disable_pressed_color: true;
                            icon_color_pressed: Palette.white;
                            clicked => {
                                NightModeAdapter.toggle();
                            }
                        }
                    }

                    Rectangle {
                        height: 24px;
                    }

                    Rectangle {
                        height: 31px;
                        width: 173px;
                        Text {
                            text: NightModeAdapter.is-active ? "Night Mode: On" : "Night Mode: Off";
                            color: Palette.white;
                            font-weight: Theme.font.weight.bold;
                            font-size: 24px;
                            horizontal-alignment: center;
                        }
                    }

                    Rectangle {
                        Text {
                            text: NightModeAdapter.status-text;
                            color: Palette.gray-50;
                            font-size: 24px;
                        }
                    }
                }

                VerticalLayout {
                    HorizontalLayout {
                        alignment: center;
                        CircleIcon {
                            icon_source: Images.restart;
                            clicked => {
                                root.restart();
                            }
                        }
                    }

                    Rectangle {
                        height: 24px;
                    }

                    Rectangle {
                        height: 31px;
                        Text {
                            text: "Restart";
                            color: Palette.white;
                            font-weight: Theme.font.weight.bold;
                            font-size: 24px;
                        }
                    }

                    Rectangle {
                        Text {
                            text: "your device";
                            color: Palette.gray-50;
                            font-size: 24px;
                        }
                    }
                }

                VerticalLayout {
                    HorizontalLayout {
                        alignment: center;
                        LongPressCircleIcon {
                            icon_source: Images.wifi-problem;
                            activated => {
                                WifiReconfigAdapter.trigger_reconfig_restart();
                            }
                        }
                    }

                    Rectangle {
                        height: 24px;
                    }

                    Rectangle {
                        height: 31px;
                        width: 140px;
                        Text {
                            text: "Reset WiFi";
                            color: Palette.white;
                            font-weight: Theme.font.weight.bold;
                            font-size: 24px;
                            horizontal-alignment: center;
                        }
                    }

                    Rectangle {
                        Text {
                            text: "hold 3 seconds";
                            color: Palette.gray-50;
                            font-size: 24px;
                        }
                    }
                }
            }
        }
    }

    // X icon positioned absolutely - declared after TouchArea to be on top
    Rectangle {
        width: 48px;
        height: 48px;
        x: root.width - self.width - 26px;
        y: 25px - root.height + root.offset;

        TouchArea {
            width: parent.width;
            height: parent.height;

            clicked => {
                root.offset = 0px;
            }

            Image {
                source: Images.x;
                width: 24px;
                height: 24px;
                x: 12px;
                y: 12px;
            }
        }
    }

    Timer {
        interval: 60s;
        running: (root.offset == root.height) && !root.dragging;

        triggered => {
            if ((root.offset == root.height) && !root.dragging) {
                root.offset = 0px;
            }
        }
    }
}
