import { Palette } from "../style/palette.slint";

// A circle icon that requires a long press (hold) to activate.
// Shows a progress ring that becomes more visible as the user holds the button.
export component LongPressCircleIcon inherits Rectangle {
    in property <image> icon_source;
    in property <brush> circle_color: rgba(255, 255, 255, 0.30);
    in property <brush> circle_color_pressed: rgba(255, 255, 255, 0.80);
    in property <color> icon_color: Palette.white;
    in property <color> icon_color_pressed: Palette.black;
    in property <color> progress_color: Palette.violet-50;
    in property <duration> hold_duration: 3000ms;

    property <bool> is_pressed: touch.pressed;
    property <float> progress: 0.0;  // 0.0 to 1.0
    property <duration> press_start_time: 0ms;
    property <bool> activated_flag: false;

    callback activated;  // Called when hold duration is reached

    width: 112px;
    height: 112px;

    // Progress ring - border becomes more visible as progress increases
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: self.width / 2;
        border-width: 4px;
        border-color: rgba(progress_color.red * 255, progress_color.green * 255, progress_color.blue * 255, root.progress);
        background: transparent;
    }

    // Main circle background
    Rectangle {
        width: root.width - 8px;
        height: root.height - 8px;
        x: 4px;
        y: 4px;
        border-radius: self.width / 2;
        background: root.is_pressed ? root.circle_color_pressed : root.circle_color;
    }

    // Icon
    Image {
        source: root.icon_source;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        colorize: root.is_pressed ? root.icon_color_pressed : root.icon_color;
    }

    touch := TouchArea {
        width: root.width;
        height: root.height;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.press_start_time = animation-tick();
                root.activated_flag = false;
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.progress = 0.0;
            }
            return EventResult.accept;
        }
    }

    // Timer to update progress while pressed
    Timer {
        interval: 16ms;  // ~60fps updates
        running: root.is_pressed && !root.activated_flag;

        triggered => {
            if (root.is_pressed && !root.activated_flag) {
                root.progress = min(1.0, (animation-tick() - root.press_start_time) / root.hold_duration);

                if (root.progress >= 1.0) {
                    root.activated_flag = true;
                    root.activated();
                    root.progress = 0.0;
                }
            }
        }
    }
}
