import { Palette } from "style/palette.slint";
import { Theme } from "style/theme.slint";
import { ScreenAdapter, StatusOverlayAdapter, UpgradeDownloadAdapter, NotificationAdapter, BitcoinAdapter, BlockHeightAdapter } from "controls/adapters.slint";
import { DateTime, InitScreen, ConnectInfoScreen, UpgradeScreen } from "controls/common.slint";
import { UpgradeDownload, UpgradeProgress, UpgradeSuccess, UpgradeFailed,
    InitStartConnect, InitWifiConnectProgress, InitWifiConnectSuccess, InitWifiConnectFailed, InitSetupSuccess, InitGeneralError, InitDeviceSetupQr, ConnectInfo,
    WifiConnectFailed, WifiConnectProgress, Alarm
} from "screens/screens.slint";
import { WidgetSize, WidgetKind, Widget } from "widgets/widget.slint";
import { BaseDimensions } from "widgets/widget-shared.slint";
import { WidgetBuilder } from "controls/widget-builder.slint";
import { Scene } from "widgets/scene.slint";
import { BraiinsPoolStyle, PoolChartDimensions, PoolWorkerStatus, BraiinsPoolPayouts, PoolPayoutType } from "widgets/categories/braiins-pool.slint";
import { SceneCycler, SceneCyclingAdapter } from "controls/scene-cycler.slint";
import { ScenePreview } from "controls/scene-preview.slint";
import { Notification } from "components/notification.slint";
import { Images } from "style/images.slint";
import { WifiAdapter, ConnectionAdapter, AlarmAdapter } from "controls/adapters.slint";
import { StatusOverlay } from "controls/status-overlay.slint";

export { ScreenAdapter, StatusOverlayAdapter, SceneCyclingAdapter, UpgradeDownloadAdapter, DateTime, NotificationAdapter, BitcoinAdapter, BlockHeightAdapter }
export { InitScreen, ConnectInfoScreen, UpgradeScreen }
export { WidgetSize, WidgetKind, Widget }
export { BraiinsPoolStyle, PoolChartDimensions, PoolWorkerStatus, BraiinsPoolPayouts, PoolPayoutType }
export { Palette, BaseDimensions }
export { WifiAdapter, ConnectionAdapter, AlarmAdapter }

export component MainWindow inherits Window {
    default-font-family: "Braiins Sans";
    background: Palette.black;
    width: 1280px;
    height: 480px;

    in property <bool> night-mode-enabled;
    in property <DateTime> system-datetime;

    // all (enabled & disabled) scenes
    in property <[Scene]> scenes;
    in property <int> preview-scene-index: -1;
    // only enabled scenes (derived from `scenes` using FilterModel)
    in property <[Scene]> cycler-scenes;
    in-out property <int> cycler-scene-index;

    // default background when other layers/screens are disabled
    Image {
        z: 1;
        source: Images.logo;
    }

    // NOTE: only one of (scene cycler, scene preview) can be rendered to avoid performance issues + therefore they share same z-index
    if ScreenAdapter.scene-cycler && root.cycler-scenes.length > 0 && root.preview-scene-index < 0: SceneCycler {
        z: 2;
        scenes: root.cycler-scenes;
        scene-index <=> root.cycler-scene-index;
        enabled: true;
        automatic-enabled: !root.night-mode-enabled;
    }

    if preview-scene-index >= 0: ScenePreview {
        z: 2;
        scene: root.scenes[root.preview-scene-index];

        // stop touch propagation (https://github.com/slint-ui/slint/discussions/8044)
        TouchArea { }
    }

    if ScreenAdapter.upgrade != UpgradeScreen.None: Rectangle {
        z: 3;

        // stop touch propagation (https://github.com/slint-ui/slint/discussions/8044)
        TouchArea { }

        if ScreenAdapter.upgrade == UpgradeScreen.Progress: UpgradeProgress { }
        if ScreenAdapter.upgrade == UpgradeScreen.Download: UpgradeDownload { }
        if ScreenAdapter.upgrade == UpgradeScreen.Success: UpgradeSuccess { }
        if ScreenAdapter.upgrade == UpgradeScreen.Failed: UpgradeFailed { }
    }

    if ScreenAdapter.connect-info != ConnectInfoScreen.None: Rectangle {
        z: 4;

        // stop touch propagation (https://github.com/slint-ui/slint/discussions/8044)
        TouchArea { }

        if ScreenAdapter.connect-info == ConnectInfoScreen.ConnectInfo: ConnectInfo { }
        if ScreenAdapter.connect-info == ConnectInfoScreen.WifiConnectFailed: WifiConnectFailed { }
        if ScreenAdapter.connect-info == ConnectInfoScreen.WifiConnectProgress: WifiConnectProgress { }
    }

    if ScreenAdapter.clock-alarm: Alarm {
        z: 6;
        datetime: root.system-datetime;
    }

    StatusOverlay {
        z: 7;
    }

    if ScreenAdapter.init != InitScreen.None: Rectangle {
        z: 8;

        // stop touch propagation (https://github.com/slint-ui/slint/discussions/8044)
        TouchArea { }

        if ScreenAdapter.init == InitScreen.StartConnect: InitStartConnect { }
        if ScreenAdapter.init == InitScreen.WifiConnectProgress: InitWifiConnectProgress { }
        if ScreenAdapter.init == InitScreen.WifiConnectSuccess: InitWifiConnectSuccess { }
        if ScreenAdapter.init == InitScreen.WifiConnectFailed: InitWifiConnectFailed { }
        if ScreenAdapter.init == InitScreen.SetupSuccess: InitSetupSuccess { }
        if ScreenAdapter.init == InitScreen.GeneralError: InitGeneralError { }
        if ScreenAdapter.init == InitScreen.DeviceSetupQr: InitDeviceSetupQr { }
    }

    // TODO: remove after proper solution for `BOS-3392` is implemented (this is only workaround)
    Text {
        height: 0px;
        width: 0px;
        visible: false;
        text: "ěščřžýďťňáíéóůúĚŠČŘŽÝĎŤŇÁÍÉÓŮÚ{}€";
    }
}
