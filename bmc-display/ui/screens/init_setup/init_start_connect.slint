import { Images } from "../../style/images.slint";
import { WifiAdapter } from "../../controls/adapters.slint";
import { Palette } from "../../style/palette.slint";
import { Theme } from "../../style/theme.slint";

export component InitStartConnect inherits Rectangle {
    background: Palette.black;

    HorizontalLayout {
        padding: 48px;
        spacing: 48px;

        // Left column: WiFi instructions
        VerticalLayout {
            alignment: center;
            spacing: 24px;
            horizontal-stretch: 1;

            Text {
                text: "Initial Setup";
                color: Palette.gray-40;
                font-size: 24px;
                font-weight: Theme.font.weight.regular;
                horizontal-alignment: center;
            }

            Image {
                source: Images.wifi-connect;
                horizontal-alignment: center;
            }

            Text {
                text: "Connect to Braiins Deck WiFi";
                color: Palette.white;
                font-size: 36px;
                font-weight: Theme.font.weight.semi-bold;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "WiFi SSID";
                    color: Palette.gray-40;
                    font-size: 24px;
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }

                Text {
                    text: WifiAdapter.ssid;
                    color: Palette.violet-50;
                    font-size: 36px;
                    font-weight: Theme.font.weight.semi-bold;
                    horizontal-alignment: center;
                }
            }
        }

        // Divider
        Rectangle {
            width: 1px;
            background: Palette.gray-80;
        }

        // Right column: QR code
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            horizontal-stretch: 1;

            Text {
                text: "Connected but nothing happens?";
                color: Palette.white;
                font-size: 28px;
                font-weight: Theme.font.weight.semi-bold;
                horizontal-alignment: center;
            }

            Text {
                text: "Scan the code!";
                color: Palette.white;
                font-size: 28px;
                font-weight: Theme.font.weight.semi-bold;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    background: Palette.white;
                    width: 240px;
                    height: 240px;

                    Image {
                        source: WifiAdapter.ap-ip-qr-code;
                        width: 224px;
                        height: 224px;
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "Or open directly in browser:";
                    color: Palette.gray-40;
                    font-size: 20px;
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }

                Text {
                    text: "http://" + WifiAdapter.ap-ip + "/";
                    color: Palette.gray-40;
                    font-size: 20px;
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
