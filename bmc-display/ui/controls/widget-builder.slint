import { WidgetContainer, WidgetSize } from "../widgets/widget.slint";
import { WidgetClockSmall, WidgetClockMedium, WidgetClockLarge } from "../widgets/categories/clock.slint";

import { ClockSmall, ClockMedium, ClockLarge } from "../widgets/widget.slint";

export component WidgetBuilder {
    in property <[ClockSmall]> clock-small;
    in property <[ClockMedium]> clock-medium;
    in property <[ClockLarge]> clock-large;

    for widget[index] in clock-small : cs-id := WidgetContainer {
        size: WidgetSize.Small;
        position-row: widget.row;
        position-col: widget.col;
        WidgetClockSmall {
            visible: true;
            //
            city-1: widget.city-1;
            position-row: parent.position-row;
            position-col: parent.position-col;
        }
    }

    for widget[index] in clock-medium : cm-id := WidgetContainer {
        size: WidgetSize.Medium;
        position-row: widget.row;
        position-col: widget.col;
        WidgetClockMedium {
            visible: true;
            //
            city-1: widget.city-1;
            city-2: widget.city-2;
            position-row: parent.position-row;
            position-col: parent.position-col;
        }
    }

    for widget[index] in clock-large : cl-id := WidgetContainer {
        size: WidgetSize.Large;
        position-row: widget.row;
        position-col: widget.col;
        WidgetClockLarge {
            visible: true;
            //
            city-1: widget.city-1;
            city-2: widget.city-2;
            city-3: widget.city-3;
            position-row: parent.position-row;
            position-col: parent.position-col;
        }
    }
}
