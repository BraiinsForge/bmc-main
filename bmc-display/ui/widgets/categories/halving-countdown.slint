import { Palette } from "../../style/palette.slint";
import { Theme } from "../../style/theme.slint";
import { WidgetSize, BaseDimensions } from "../widget-shared.slint";

export struct WidgetHalvingCountdownData {
    // Raw countdown data
    total-seconds: int,
    blocks-remaining: int,
    // Backend-formatted strings for fullscreen
    predicted-date: string,      // e.g., "Apr. 01 2028"
    predicted-time: string,      // e.g., "4:34 PM GMT+1"
    target-block: string,        // e.g., "1,050,000"
}

// ============================================================================
// FULLSCREEN WIDGET
// ============================================================================
component WidgetHalvingCountdownFull inherits Rectangle {
    in property <WidgetHalvingCountdownData> data;

    background: Palette.black;

    // Time calculations
    property <int> seconds-per-minute: 60;
    property <int> seconds-per-hour: 3600;
    property <int> seconds-per-day: 86400;
    property <int> total-days: data.total-seconds / seconds-per-day;
    property <int> hours: (data.total-seconds - (total-days * seconds-per-day)) / seconds-per-hour;
    property <int> minutes: (data.total-seconds - (total-days * seconds-per-day) - (hours * seconds-per-hour)) / seconds-per-minute;
    property <bool> is-complete: data.total-seconds <= 0;

    // Format number with leading zero
    pure function pad2(n: int) -> string {
        if (n < 10) {
            return "0" + n;
        }
        return n;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top tile - Title and countdown
        Rectangle {
            vertical-stretch: 1;
            background: #0F0F0F;
            border-radius: 8px;

            VerticalLayout {
                alignment: center;
                spacing: 16px;

                // Title
                Text {
                    text: "Halving Countdown";
                    color: Palette.gray-60;
                    font-size: 32px;
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }

                if is-complete: Text {
                    text: "Halving Complete!";
                    color: Palette.green-40;
                    font-size: 120px;
                    font-weight: Theme.font.weight.bold;
                    horizontal-alignment: center;
                }

                if !is-complete: HorizontalLayout {
                    alignment: center;
                    spacing: 24px;

                    // Days column
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: total-days + "";
                            color: Palette.violet-50;
                            font-size: 120px;
                            font-weight: Theme.font.weight.bold;
                            font-family: "Braiins Deck Sans";
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Days";
                            color: Palette.gray-60;
                            font-size: 28px;
                            font-weight: Theme.font.weight.regular;
                            horizontal-alignment: center;
                        }
                    }

                    // Colon separator
                    Text {
                        text: ":";
                        color: Palette.violet-50;
                        font-size: 120px;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                        vertical-alignment: top;
                    }

                    // Hours column
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: pad2(hours);
                            color: Palette.violet-50;
                            font-size: 120px;
                            font-weight: Theme.font.weight.bold;
                            font-family: "Braiins Deck Sans";
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Hours";
                            color: Palette.gray-60;
                            font-size: 28px;
                            font-weight: Theme.font.weight.regular;
                            horizontal-alignment: center;
                        }
                    }

                    // Colon separator
                    Text {
                        text: ":";
                        color: Palette.violet-50;
                        font-size: 120px;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                        vertical-alignment: top;
                    }

                    // Minutes column
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: pad2(minutes);
                            color: Palette.violet-50;
                            font-size: 120px;
                            font-weight: Theme.font.weight.bold;
                            font-family: "Braiins Deck Sans";
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Min.";
                            color: Palette.gray-60;
                            font-size: 28px;
                            font-weight: Theme.font.weight.regular;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // Bottom tiles row
        HorizontalLayout {
            height: 160px;
            spacing: 12px;

            // Left tile - Predicted Date
            Rectangle {
                horizontal-stretch: 1;
                background: #0F0F0F;
                border-radius: 8px;

                VerticalLayout {
                    alignment: center;
                    spacing: 16px;

                    Text {
                        text: "Predicted Date";
                        color: Palette.gray-60;
                        font-size: 24px;
                        font-weight: Theme.font.weight.regular;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: data.predicted-date;
                        color: Palette.white;
                        font-size: 40px;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                        horizontal-alignment: center;
                    }
                    Text {
                        text: data.predicted-time;
                        color: Palette.gray-60;
                        font-size: 24px;
                        font-weight: Theme.font.weight.regular;
                        horizontal-alignment: center;
                    }
                }
            }

            // Right tile - Block Remaining
            Rectangle {
                horizontal-stretch: 1;
                background: #0F0F0F;
                border-radius: 8px;

                VerticalLayout {
                    alignment: center;
                    spacing: 16px;

                    Text {
                        text: "Block Remaining";
                        color: Palette.gray-60;
                        font-size: 24px;
                        font-weight: Theme.font.weight.regular;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: data.blocks-remaining + "";
                        color: Palette.white;
                        font-size: 40px;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Target #" + data.target-block;
                        color: Palette.gray-60;
                        font-size: 24px;
                        font-weight: Theme.font.weight.regular;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

// ============================================================================
// LARGE WIDGET
// ============================================================================
