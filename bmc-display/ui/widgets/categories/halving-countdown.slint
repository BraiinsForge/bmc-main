// ============================================================================
// SMALL / MEDIUM WIDGETS
// ============================================================================
component WidgetHalvingCountdownCompact inherits Rectangle {
    in property <WidgetSize> size;
    in property <WidgetHalvingCountdownData> data;

    background: Palette.black;

    // Time calculations
    property <int> seconds-per-minute: 60;
    property <int> seconds-per-hour: 3600;
    property <int> seconds-per-day: 86400;
    property <int> total-days: data.total-seconds / seconds-per-day;
    property <int> hours: (data.total-seconds - (total-days * seconds-per-day)) / seconds-per-hour;
    property <int> minutes: (data.total-seconds - (total-days * seconds-per-day) - (hours * seconds-per-hour)) / seconds-per-minute;
    property <bool> is-complete: data.total-seconds <= 0;

    // Format number with leading zero
    pure function pad2(n: int) -> string {
        if (n < 10) {
            return "0" + n;
        }
        return n;
    }

    // Size-dependent values
    property <length> title-fontsize: (WidgetSize.Small == size) ? 20px : 26px;
    property <length> countdown-fontsize: (WidgetSize.Small == size) ? 48px : 96px;
    property <length> label-fontsize: (WidgetSize.Small == size) ? 18px : 24px;
    property <length> spacing-size: (WidgetSize.Small == size) ? 10px : 20px;

    VerticalLayout {
        padding: 8px;

        // Single tile with countdown
        Rectangle {
            background: #0F0F0F;
            border-radius: 8px;

            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                alignment: space-between;

                // Title at top
                Text {
                    text: "Halving Countdown";
                    color: Palette.gray-60;
                    font-size: title-fontsize;
                    font-weight: Theme.font.weight.semi-bold;
                    horizontal-alignment: center;
                }

                if is-complete: Text {
                    text: "Halving Complete!";
                    color: Palette.green-40;
                    font-size: countdown-fontsize;
                    font-weight: Theme.font.weight.bold;
                    horizontal-alignment: center;
                }

                // Countdown numbers (centered)
                if !is-complete: HorizontalLayout {
                    alignment: center;
                    spacing: spacing-size;

                    Text {
                        text: total-days + "";
                        color: Palette.violet-50;
                        font-size: countdown-fontsize;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                        horizontal-alignment: center;
                    }
                    Text {
                        text: ":";
                        color: Palette.violet-50;
                        font-size: countdown-fontsize;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                    }
                    Text {
                        text: pad2(hours);
                        color: Palette.violet-50;
                        font-size: countdown-fontsize;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                        horizontal-alignment: center;
                    }
                    Text {
                        text: ":";
                        color: Palette.violet-50;
                        font-size: countdown-fontsize;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                    }
                    Text {
                        text: pad2(minutes);
                        color: Palette.violet-50;
                        font-size: countdown-fontsize;
                        font-weight: Theme.font.weight.bold;
                        font-family: "Braiins Deck Sans";
                        horizontal-alignment: center;
                    }
                }

                // Labels at bottom
                if !is-complete: HorizontalLayout {
                    alignment: center;
                    spacing: spacing-size * 3;

                    Text {
                        text: "Days";
                        color: Palette.gray-60;
                        font-size: label-fontsize;
                        font-weight: Theme.font.weight.semi-bold;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Hours";
                        color: Palette.gray-60;
                        font-size: label-fontsize;
                        font-weight: Theme.font.weight.semi-bold;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Min.";
                        color: Palette.gray-60;
                        font-size: label-fontsize;
                        font-weight: Theme.font.weight.semi-bold;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

// ============================================================================
// MAIN EXPORTED WIDGET
// ============================================================================
export component WidgetHalvingCountdown inherits Rectangle {
    in property <WidgetSize> size;
    in property <WidgetHalvingCountdownData> data;

    background: Palette.black;
    width: BaseDimensions.widget-width(size);
    height: BaseDimensions.widget-height(size);

    if size == WidgetSize.Full: WidgetHalvingCountdownFull {
        width: 100%;
        height: 100%;
        data: data;
    }

    if size == WidgetSize.Large: WidgetHalvingCountdownLarge {
        width: 100%;
        height: 100%;
        data: data;
    }

    if size == WidgetSize.Small || size == WidgetSize.Medium: WidgetHalvingCountdownCompact {
        width: 100%;
        height: 100%;
        size: size;
        data: data;
    }
}
