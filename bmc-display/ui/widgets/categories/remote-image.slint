import { Palette } from "../../style/palette.slint";
import { Theme } from "../../style/theme.slint";
import { WidgetSize } from "../widget-shared.slint";

export enum WidgetRemoteImageState {
    Initial,
    ConfigurationError,
    Loading,
    LoadingSuccess,
    LoadingError,
    UnexpectedError,
}

export struct WidgetRemoteImageData {
    image: image,
    state: WidgetRemoteImageState,
    stale-text: string,
    error-text: string,
    name: string,
}

export component WidgetRemoteImage inherits Rectangle {
    in property <WidgetSize> size;
    in property <WidgetRemoteImageData> data;

    property <bool> has-image: root.data.image.width > 0 && root.data.image.height > 0;
    property <bool> show-full-overlay:
        root.data.state == WidgetRemoteImageState.ConfigurationError
        || root.data.state == WidgetRemoteImageState.UnexpectedError
        || ((root.data.state == WidgetRemoteImageState.Loading || root.data.state == WidgetRemoteImageState.LoadingError) && !root.has-image);

    background: Palette.black;

    // Always render the cached image when available (visible behind
    // the semi-transparent overlay so content peeks through).
    if root.has-image: Image {
        width: root.width;
        height: root.height;
        source: root.data.image;
    }

    // Full overlay: shown when there is no cached image (initial load)
    // or on configuration/unexpected errors. Uses 80% opacity so cached
    // content (if any) still peeks through.
    if !root.has-image || root.show-full-overlay: Rectangle {
        clip: true;

        Rectangle {
            background: Palette.black;
            opacity: 80%;
        }

        if root.data.state == WidgetRemoteImageState.ConfigurationError: VerticalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                color: Palette.white;
                font-size: 20px;
                font-weight: Theme.font.weight.bold;
                horizontal-alignment: center;
                text: "Invalid configuration";
            }

            Text {
                color: Palette.white;
                font-size: 16px;
                font-weight: Theme.font.weight.regular;
                horizontal-alignment: center;
                wrap: word-wrap;
                text: "Please check widget configuration";
            }
        }

        if root.data.state == WidgetRemoteImageState.Loading || root.data.state == WidgetRemoteImageState.LoadingError: VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                color: Palette.white;
                font-size: 20px;
                font-weight: Theme.font.weight.bold;
                horizontal-alignment: center;
                text: root.data.name;
            }

            if root.data.error-text != "": Text {
                color: Palette.orange-40;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
                text: root.data.error-text;
            }
        }

        if root.data.state == WidgetRemoteImageState.Loading || root.data.state == WidgetRemoteImageState.LoadingError: Rectangle {
            x: 8px;
            y: root.height - self.height - 8px;
            width: waiting-text-el.preferred-width + 16px;
            height: waiting-text-el.preferred-height + 8px;
            border-radius: 4px;

            Rectangle {
                background: Palette.black;
                opacity: 70%;
                border-radius: parent.border-radius;
            }

            waiting-text-el := Text {
                color: Palette.orange-40;
                font-size: 12px;
                text: "Waiting for initial data";
            }
        }

        if root.data.state == WidgetRemoteImageState.UnexpectedError: Text {
            color: Palette.white;
            font-size: 20px;
            font-weight: Theme.font.weight.bold;
            horizontal-alignment: center;
            text: "Unexpected error";
        }
    }

    if root.data.stale-text != "": Rectangle {
        x: 8px;
        y: root.height - self.height - 8px;
        width: stale-text-el.preferred-width + 16px;
        height: stale-text-el.preferred-height + 8px;
        border-radius: 4px;

        Rectangle {
            background: Palette.black;
            opacity: 70%;
            border-radius: parent.border-radius;
        }

        stale-text-el := Text {
            color: Palette.orange-40;
            font-size: 12px;
            text: root.data.stale-text;
        }
    }
}
