import { Palette } from "../../style/palette.slint";
import { Theme } from "../../style/theme.slint";
import { Images } from "../../style/images.slint";
import { WidgetSize, FontStyle, BaseDimensions } from "../widget-shared.slint";

export struct WidgetCountdownConfig {
    label: string,
    target-timestamp: int,
    background-color: brush,
    numbers-font-style: FontStyle,
}

export struct WidgetCountdownData {
    config: WidgetCountdownConfig,
    label: string,
    is-completed: bool,
    primary-value: string,
    primary-unit: string,
    secondary-value: string,
    secondary-unit: string,
    tertiary-value: string,
    tertiary-unit: string,
}

export component WidgetCountdown inherits Rectangle {
    in property <WidgetSize> size;
    in property <WidgetCountdownData> data;
    callback dismissed();

    background: data.config.background-color;

    width: BaseDimensions.widget-width(size);
    height: BaseDimensions.widget-height(size);

    pure function font-weight-from-style(style: FontStyle) -> int {
        if style == FontStyle.Light {
            return Theme.font.weight.regular;
        } else if style == FontStyle.Medium {
            return Theme.font.weight.semi-bold;
        } else {
            return Theme.font.weight.bold;
        }
    }

    in property <int> font-weight: font-weight-from-style(data.config.numbers-font-style);

    // Calculate font sizes based on widget size
    pure function number-fontsize(size: WidgetSize) -> length {
        if (WidgetSize.Small == size) {
            return 72px;
        } else if (WidgetSize.Medium == size) {
            return 96px;
        } else if (WidgetSize.Large == size) {
            return 140px;
        } else {
            // WidgetSize.Full
            return 200px;
        }
    }

    pure function unit-fontsize(size: WidgetSize) -> length {
        if (WidgetSize.Small == size) {
            return 18px;
        } else if (WidgetSize.Medium == size) {
            return 24px;
        } else if (WidgetSize.Large == size) {
            return 32px;
        } else {
            // WidgetSize.Full
            return 48px;
        }
    }

    pure function separator-fontsize(size: WidgetSize) -> length {
        if (WidgetSize.Small == size) {
            return 48px;
        } else if (WidgetSize.Medium == size) {
            return 64px;
        } else if (WidgetSize.Large == size) {
            return 96px;
        } else {
            // WidgetSize.Full
            return 140px;
        }
    }

    VerticalLayout {
        padding-left: (WidgetSize.Full == size) ? 24px : 16px;
        padding-right: (WidgetSize.Full == size) ? 24px : 16px;
        padding-top: (WidgetSize.Full == size) ? 16px : 8px;
        padding-bottom: (WidgetSize.Full == size || WidgetSize.Large == size) ? 24px : 12px;
        alignment: space-between;

        // Header with icon and label
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            Image {
                source: Images.alarm-bell;
                width: 24px;
                height: 24px;
                colorize: Palette.gray-60;
            }
            Text {
                text: data.label != "" ? data.label : "Countdown";
                color: Palette.gray-60;
                font-size: 24px;
                font-weight: Theme.font.weight.regular;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        // Main countdown display
        if data.is-completed: TouchArea {
            clicked => { root.dismissed(); }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "COMPLETED!";
                    color: Palette.orange-40;
                    font-size: number-fontsize(size) * 0.6;
                    font-weight: Theme.font.weight.bold;
                    font-family: "Braiins Deck Sans";
                    horizontal-alignment: center;
                }
            }
        }

        if !data.is-completed: HorizontalLayout {
            alignment: center;
            spacing: (WidgetSize.Small == size || WidgetSize.Medium == size) ? 8px : 16px;

            // Primary value column
            VerticalLayout {
                alignment: center;
                Text {
                    text: data.primary-value;
                    color: Palette.white;
                    font-size: number-fontsize(size);
                    font-weight: font-weight;
                    font-family: "Braiins Deck Sans";
                    horizontal-alignment: center;
                }
                Text {
                    text: data.primary-unit;
                    color: Palette.gray-60;
                    font-size: unit-fontsize(size);
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }
            }

            // Separator
            Text {
                text: ":";
                color: Palette.gray-60;
                font-size: separator-fontsize(size);
                font-weight: Theme.font.weight.regular;
                vertical-alignment: center;
            }

            // Secondary value column
            VerticalLayout {
                alignment: center;
                Text {
                    text: data.secondary-value;
                    color: Palette.white;
                    font-size: number-fontsize(size);
                    font-weight: font-weight;
                    font-family: "Braiins Deck Sans";
                    horizontal-alignment: center;
                }
                Text {
                    text: data.secondary-unit;
                    color: Palette.gray-60;
                    font-size: unit-fontsize(size);
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }
            }

            // Tertiary separator (only when tertiary value exists)
            if data.tertiary-value != "": Text {
                text: ":";
                color: Palette.gray-60;
                font-size: separator-fontsize(size);
                font-weight: Theme.font.weight.regular;
                vertical-alignment: center;
            }

            // Tertiary value column (only when tertiary value exists)
            if data.tertiary-value != "": VerticalLayout {
                alignment: center;
                Text {
                    text: data.tertiary-value;
                    color: Palette.white;
                    font-size: number-fontsize(size);
                    font-weight: font-weight;
                    font-family: "Braiins Deck Sans";
                    horizontal-alignment: center;
                }
                Text {
                    text: data.tertiary-unit;
                    color: Palette.gray-60;
                    font-size: unit-fontsize(size);
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }
            }
        }

        // Spacer at bottom for visual balance
        Rectangle {
            height: (WidgetSize.Full == size || WidgetSize.Large == size) ? 24px : 8px;
        }
    }
}
