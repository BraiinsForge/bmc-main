}

component WidgetClockDigitalSmall inherits Rectangle {
    in property <WidgetClockConfig> config;
    in property <DateTime> datetime;

    width: 317px;
    height: 238px;

    WidgetClockDigitalTemplate {
        config: root.config;
        datetime: root.datetime;
        show-formatted-date: true;
        time-font-size: 64px;
        header-font-size: 24px;
        ampm-font-size: 24px;
        top-padding: 20px;
        bottom-padding: 20px;
        show-year: false;
        show-alarm: false;
    }
}

export component WidgetClockDigital inherits Rectangle {
    in property <WidgetSize> size;
    in property <WidgetClockConfig> config;
    in property <DateTime> datetime;

    if size == WidgetSize.Full: WidgetClockDigitalFull {
        config: root.config;
        datetime: root.datetime;
    }
    if size == WidgetSize.Large: WidgetClockDigitalLarge {
        config: root.config;
        datetime: root.datetime;
    }
    if size == WidgetSize.Medium: WidgetClockDigitalMedium {
        config: root.config;
        datetime: root.datetime;
    }
    if size == WidgetSize.Small: WidgetClockDigitalSmall {
        config: root.config;
        datetime: root.datetime;
    }
}

export component WidgetClock {
    in property <WidgetSize> size;
    in property <WidgetClockConfig> config;
    in property <DateTime> datetime;
    in property <WidgetClockData> data;

    if config.clock-style == ClockStyle.AnalogRound: WidgetClockAnalogRound {
        size: root.size;
        config: root.config;
        datetime: root.datetime;
        data: root.data;
    }
    if config.clock-style == ClockStyle.AnalogRect: WidgetClockAnalogRect {
        size: root.size;
        config: root.config;
        datetime: root.datetime;
        data: root.data;
    }
    if config.clock-style == ClockStyle.Digital: WidgetClockDigital {
        size: root.size;
        config: root.config;
        datetime: root.datetime;
    }
}
