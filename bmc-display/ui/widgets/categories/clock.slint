import { Position, Time } from "../../components/components.slint";
import { Palette } from "../../style/styles.slint";
import { Backend } from "../../backend.slint";

export component WidgetClockSmall inherits Rectangle {
    in property <string> city-1;
    in property <int> position-row;
    in property <int> position-col;
    property <string> time-sec-1;

    timer := Timer {
        interval: 500ms;
        running: true;
        triggered => {
            root.time-sec-1 = Backend.get-time(city-1);
        }
    }

    background: Palette.blue-60;
    border-color: black;
    border-width: 5px;
    border-radius: 20px;

    VerticalLayout {
        Position {
            row-index: root.position-row;
            col-index: root.position-col;
        }
        Text {
            text: "Small";
            font-size: 20px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            Time {
                city: city-1;
                time-sec: time-sec-1;
            }
        }
    }
}

