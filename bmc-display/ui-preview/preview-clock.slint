import { Palette } from "../ui/style/palette.slint";
import { Theme } from "../ui/style/theme.slint";
import { DateTime } from "../ui/controls/common.slint";
import { WidgetSize, FontStyle } from "../ui/widgets/widget-shared.slint";
import { ClockStyle, WidgetClockConfig, WidgetClockData, WidgetClock,
    WidgetClockDigital, WidgetClockAnalogRound, WidgetClockAnalogRect } from "../ui/widgets/categories/clock.slint";
import { WidgetBtcGraph, WidgetBtcConfig, WidgetBtcData } from "../ui/widgets/categories/ticker-btc.slint";
import { AlarmAdapter, BitcoinAdapter } from "../ui/controls/adapters.slint";
import { Alarm } from "../ui/screens/screens.slint";
export { AlarmAdapter, BitcoinAdapter }

// Shared test data
global TestData {
    out property <DateTime> datetime: {
        is-24-format: false,
        hour24: 14,
        hour12: 2,
        is-pm: true,
        minute: 30,
        second: 45,
        day: 15,
        month: 2,
        month-name: "Feb",
        year: 2026,
        weekday: "Sun",
        time-sec-24: "14:30:40",
        time-sec-12: "02:30:40",
        time-24: "14:30",
        time-12: "2:30",
        date: "2026-02-15",
        timezone: "Bahia Banderas",
        utc-offset: "-6",
    };

    out property <WidgetClockConfig> digital-config: {
        clock-style: ClockStyle.Digital,
        numbers-font-style: FontStyle.Bold,
        show-date: true,
        show-seconds: true,
        show-timezone: true,
    };

    out property <WidgetClockConfig> analog-round-config: {
        clock-style: ClockStyle.AnalogRound,
        numbers-font-style: FontStyle.Medium,
        show-date: true,
        show-seconds: true,
        show-timezone: true,
    };

    out property <WidgetClockConfig> analog-rect-config: {
        clock-style: ClockStyle.AnalogRect,
        numbers-font-style: FontStyle.Medium,
        show-date: true,
        show-seconds: true,
        show-timezone: true,
    };
}

// ── Digital (all variants) ───────────────────────────────

export component DigitalAll inherits Window {
    default-font-family: "Braiins Sans";
    background: white;

    property <length> gap: 10px;

    width: 1280px;
    height: 480px + gap + 480px;

    VerticalLayout {
        spacing: gap;

        // Full
        Rectangle {
            background: Palette.black;
            width: 1280px;
            height: 480px;

            WidgetClockDigital {
                width: parent.width;
                height: parent.height;
                size: WidgetSize.Full;
                config: TestData.digital-config;
                datetime: TestData.datetime;
            }
        }

        // Large + Medium + Small
        HorizontalLayout {
            spacing: root.gap;

            Rectangle {
                background: Palette.black;
                width: 638px;
                height: 480px;

                WidgetClockDigital {
                    width: parent.width;
                    height: parent.height;
                    size: WidgetSize.Large;
                    config: TestData.digital-config;
                    datetime: TestData.datetime;
                }
            }

            VerticalLayout {
                spacing: root.gap;

                Rectangle {
                    background: Palette.black;
                    width: 638px;
                    height: 238px;

                    WidgetClockDigital {
                        width: parent.width;
                        height: parent.height;
                        size: WidgetSize.Medium;
                        config: TestData.digital-config;
                        datetime: TestData.datetime;
                    }
                }

                Rectangle {
                    background: Palette.black;
                    width: 317px;
                    height: 238px;

                    WidgetClockDigital {
                        width: parent.width;
                        height: parent.height;
                        size: WidgetSize.Small;
                        config: TestData.digital-config;
                        datetime: TestData.datetime;
                    }
                }
            }
        }
    }
}

