# Guest-side event daemon: build, deploy, and test.
mod harness 'harness/justfile'

[private]
default:
    @just --justfile {{ source_file() }} --list

# Rebuild the OpenWrt feed cache after changing packageList or openwrtVersion in dl-cache/openwrt-config.nix.
update-cache:
    #!/usr/bin/env bash
    set -euo pipefail
    cd dl-cache
    for arch in x86_64 aarch64; do
      echo "=== Building feed cache for $arch ==="
      result=$(nix build -L ".#$arch" --option sandbox false --no-link --print-out-paths)
      install -m644 "$result/$arch.tar"    data/
      install -m644 "$result/$arch.sha256" data/
      echo "  → data/$arch.tar + data/$arch.sha256"
    done
    echo ""
    echo "Feed cache updated.  Commit the changes:"
    echo "  git add bmc-virt/dl-cache/data/"
    echo "  git commit -m 'bmc-virt: dl-cache: Refresh OpenWrt feed cache'"

logs:
    ./scripts/get-logs.sh

clean:
    ./scripts/clean.sh

display:
    ./scripts/display.sh

# Foreground console app attached to this terminal; for a detached form that logs to vm-data/console.log use `display`.
console *EXTRA:
    BMC_VIRT_RELAY_ADDR="127.0.0.1:5910" \
        cargo run -p bmc-virt-console --manifest-path ../Cargo.toml {{ EXTRA }}

run CONFIG="combined-flip-clocks":
    ./scripts/run.sh --config {{ CONFIG }}

ssh:
    ./scripts/ssh.sh

stop:
    ./scripts/stop.sh
