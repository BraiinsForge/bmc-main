import '../../common.justfile'

# Run a harness script in the dev shell (lint/type/test live at the repo root).
run script:
    #!/usr/bin/env bash
    set -euo pipefail
    script="{{ script }}"
    invocation="{{ invocation_directory() }}"
    if [[ "$script" = /* ]]; then
        script_path="$script"
    elif [[ -e "$invocation/$script" ]]; then
        script_path="$(realpath "$invocation/$script")"
    elif [[ -e "$PWD/$script" ]]; then
        script_path="$(realpath "$PWD/$script")"
    else
        echo "Script not found: $script (cwd=$invocation, harness=$PWD)" >&2
        exit 1
    fi
    nix develop --command uv run python "$script_path"
