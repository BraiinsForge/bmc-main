#!/bin/sh /etc/rc.common
# procd service for bmc-openwrt (the main Deck app).
#
# Paths (binary, log, config, runtime dir, rr bundle) are sourced from
# /etc/bmc-virt/paths.env — rendered by bmc-virt/flake.nix at overlay
# build time. Optional /etc/bmc-virt/bmc-openwrt.env selects rr record
# mode (RR_ENABLED=1) and optionally overrides XDG_RUNTIME_DIR via
# XDG_RUNTIME_DIR_OVERRIDE.
START=85
USE_PROCD=1

# shellcheck disable=SC1091
. /etc/bmc-virt/paths.env

ENV_FILE="/etc/bmc-virt/bmc-openwrt.env"

start_service() {
    [ -x "$BMC_BIN" ] || return 0

    # Mode defaults (non-rr)
    RR_ENABLED=
    XDG_RUNTIME_DIR_OVERRIDE=
    # shellcheck disable=SC1090
    [ -f "$ENV_FILE" ] && . "$ENV_FILE"

    # XDG_RUNTIME_DIR: required by the Wayland compositor.
    # See nix/pkgs/core/scripts/start-compositor for the Deck equivalent.
    XDG_RUNTIME_DIR_EFF="${XDG_RUNTIME_DIR_OVERRIDE:-$BMC_RUNTIME_DIR}"
    mkdir -p "$XDG_RUNTIME_DIR_EFF"
    # Widget log directory (widgets write to /var/log/bmc/)
    mkdir -p /var/log/bmc

    # Widgets path: written by deploy script, points to nix store (via 9p mount)
    WIDGETS_ARGS=""
    if [ -f /etc/bmc-virt/widgets-path ]; then
        WIDGETS_PATH=$(cat /etc/bmc-virt/widgets-path)
        [ -d "$WIDGETS_PATH" ] && WIDGETS_ARGS="--widgets-path $WIDGETS_PATH"
    fi

    # rr mode prepends a record wrapper and forces the headless compositor
    # (rr hides /dev/dri from recorded processes).
    LAUNCHER=""
    EXTRA_ARGS=""
    if [ -n "$RR_ENABLED" ]; then
        rm -rf "$RR_TRACE_DIR"
        LAUNCHER="$RR_BUNDLE/bin/run-rr.sh record -n --output-trace-dir=$RR_TRACE_DIR --resource-path=$RR_BUNDLE"
        EXTRA_ARGS="--headless-compositor"
    fi

    WWW_ARGS="--www-path /www/bmc"

    procd_open_instance
    procd_set_param command /bin/sh -c \
        "exec $LAUNCHER $BMC_BIN $WIDGETS_ARGS $EXTRA_ARGS $WWW_ARGS >>$BMC_LOG 2>&1"
    # BMC_WIDGET_GC_PERIOD_SECS shortens the widget asset-cache GC cadence from
    # the 30-min default so the GC is observable within a VM session (#BDK-546).
    procd_set_param env \
        RUST_BACKTRACE=full \
        RUST_LOG=debug \
        BMC_WIDGET_GC_PERIOD_SECS=120 \
        BMC_WIFI_SYSPATH=/sys/devices/virtual/mac80211_hwsim/hwsim0/ \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR_EFF"
    procd_set_param file "$BMC_CONFIG"
    procd_set_param pidfile "$BMC_PID_FILE"
    procd_close_instance
}
