#!/bin/sh /etc/rc.common
# procd service for bmc-virt-relay (display capture + LED + IPC bridge).
# Start after the VM harness and let the relay manage compositor discovery
# and reconnects internally.
#
# Paths sourced from /etc/bmc-virt/paths.env (rendered by bmc-virt/flake.nix).
START=82
USE_PROCD=1

# shellcheck disable=SC1091
. /etc/bmc-virt/paths.env

start_service() {
    [ -x /usr/bin/bmc-virt-relay ] || return 0

    procd_open_instance
    procd_set_param command /bin/sh -c "exec /usr/bin/bmc-virt-relay 60 >>$RELAY_LOG 2>&1"
    procd_set_param env \
        XDG_RUNTIME_DIR="$BMC_RUNTIME_DIR" \
        BMC_LOG="$BMC_LOG" \
        RELAY_LOG="$RELAY_LOG"
    procd_set_param pidfile /var/run/bmc-virt-relay.pid
    procd_close_instance
}
