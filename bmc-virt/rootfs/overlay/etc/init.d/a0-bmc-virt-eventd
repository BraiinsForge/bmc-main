#!/bin/sh /etc/rc.common
# procd service for bmc-virt-eventd (event daemon for host ↔ guest signaling).
# Must start AFTER a-bmc-virt-setup (START=80) which mounts /nix/store via 9p,
# but BEFORE bmc-openwrt (85) and relay (95) so it captures their lifecycle.
# NOTE: init script name must start with a letter — OpenWrt rc.common breaks
# on numeric prefixes (the "start" argument gets parsed as a shell command).
START=81
USE_PROCD=1

LOGFILE="/tmp/bmc-virt-eventd.log"
PYTHON_PATH_FILE="/etc/bmc-virt/eventd-python"

start_service() {
    [ -f "$PYTHON_PATH_FILE" ] || return 0
    PYTHON=$(cat "$PYTHON_PATH_FILE")
    [ -x "$PYTHON" ] || { logger -t eventd "python not found: $PYTHON"; return 0; }

    procd_open_instance
    procd_set_param command /bin/sh -c "exec $PYTHON -m bmc_virt.server >>$LOGFILE 2>&1"
    procd_set_param pidfile /var/run/bmc-virt-eventd.pid
    procd_close_instance
}
