import { ProgressIndicator } from "std-widgets.slint";
import { Palette } from "style/palette.slint";
import { Theme } from "style/theme.slint";

export global WifiAdapter {
    in property <string> ssid;
    in property <string> ap-ip;
    in property <image> ap-ip-qr-code;
}

export component InitWindow inherits Window {
    width: 1280px;
    height: 480px;
    background: Palette.black;

    in property <string> status-text: "Initializing...";
    in property <string> detail-text: "";
    in property <float> progress: 0.0;
    in property <bool> show-progress: false;
    in property <bool> show-reconfigure-button: false;
    in property <bool> show-retry-button: false;
    in property <bool> show-wifi-setup: false;
    in property <bool> show-wifi-subtitle: false;

    callback reconfigure-wifi();
    callback retry-download();

    // WiFi setup screen (two-column layout from InitStartConnect)
    if root.show-wifi-setup: HorizontalLayout {
        padding: 48px;
        spacing: 48px;

        // Left column: WiFi instructions
        VerticalLayout {
            alignment: center;
            spacing: 24px;
            horizontal-stretch: 1;

            Text {
                text: "Initial Setup";
                color: Palette.gray-40;
                font-size: 24px;
                font-weight: Theme.font.weight.regular;
                horizontal-alignment: center;
            }

            Image {
                source: @image-url("assets/images/wifi_connect.svg");
                horizontal-alignment: center;
            }

            Text {
                text: "Connect to Braiins Deck WiFi";
                color: Palette.white;
                font-size: 36px;
                font-weight: Theme.font.weight.semi-bold;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "WiFi SSID";
                    color: Palette.gray-40;
                    font-size: 24px;
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }

                Text {
                    text: WifiAdapter.ssid;
                    color: Palette.violet-50;
                    font-size: 36px;
                    font-weight: Theme.font.weight.semi-bold;
                    horizontal-alignment: center;
                }
            }
        }

        // Divider
        Rectangle {
            width: 1px;
            background: Palette.gray-80;
        }

        // Right column: QR code
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            horizontal-stretch: 1;

            Text {
                text: "Connected but nothing happens?";
                color: Palette.white;
                font-size: 28px;
                font-weight: Theme.font.weight.semi-bold;
                horizontal-alignment: center;
            }

            Text {
                text: "Scan the code!";
                color: Palette.white;
                font-size: 28px;
                font-weight: Theme.font.weight.semi-bold;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    background: Palette.white;
                    width: 240px;
                    height: 240px;

                    Image {
                        source: WifiAdapter.ap-ip-qr-code;
                        width: 224px;
                        height: 224px;
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "Or open directly in browser:";
                    color: Palette.gray-40;
                    font-size: 20px;
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }

                Text {
                    text: "http://" + WifiAdapter.ap-ip + "/";
                    color: Palette.gray-40;
                    font-size: 20px;
                    font-weight: Theme.font.weight.regular;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Progress/status screen (existing layout)
    if !root.show-wifi-setup: VerticalLayout {
        padding-left: 120px;
        padding-right: 120px;
        spacing: 15px;
        alignment: center;

        HorizontalLayout {
            padding-top: 40px;
            padding-bottom: 15px;
            alignment: center;
            Rectangle {
                width: 80px;
                height: 80px;
                Image {
                    source: @image-url("assets/images/tools.svg");
                }
            }
        }

        Text {
            text: root.status-text;
            color: Palette.white;
            font-size: 24px;
            font-weight: Theme.font.weight.bold;
            horizontal-alignment: center;
        }

        if root.show-wifi-subtitle: Text {
            text: WifiAdapter.ssid;
            color: Palette.violet-50;
            font-size: 28px;
            font-weight: Theme.font.weight.semi-bold;
            horizontal-alignment: center;
        }

        ProgressIndicator {
            height: root.show-progress ? 7px : 0px;
            progress: root.progress * 100%;
            visible: root.show-progress;
        }

        if root.show-reconfigure-button || root.show-retry-button: HorizontalLayout {
            padding-top: 16px;
            spacing: 16px;
            alignment: center;

            if root.show-retry-button: TouchArea {
                width: 280px;
                height: 56px;
                clicked => {
                    root.retry-download();
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Palette.violet-50;
                    border-radius: 8px;

                    Text {
                        text: "Retry download";
                        color: Palette.white;
                        font-size: 24px;
                        font-weight: Theme.font.weight.semi-bold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if root.show-reconfigure-button: TouchArea {
                width: 280px;
                height: 56px;
                clicked => {
                    root.reconfigure-wifi();
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Palette.violet-50;
                    border-radius: 8px;

                    Text {
                        text: "Reconfigure WiFi";
                        color: Palette.white;
                        font-size: 24px;
                        font-weight: Theme.font.weight.semi-bold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.detail-text != "": Text {
            text: root.detail-text;
            color: Palette.gray-50;
            font-size: 18px;
            font-weight: Theme.font.weight.regular;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}
