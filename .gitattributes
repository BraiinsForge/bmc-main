# Frontend
frontend/.yarn/**            linguist-vendored
frontend/.yarn/releases/*    binary
frontend/.yarn/plugins/**/*  binary
frontend/.pnp.*              binary linguist-generated
frontend/**/*.d.ts           linguist-generated gitlab-generated
frontend/**/*_pb.ts          linguist-generated gitlab-generated

# Language overrides
flake.lock        linguist-generated gitlab-generated linguist-language=json
frontend/**/*.ejs linguist-language=html
frontend/**/*.cjs linguist-language=javascript
frontend/**/*.mjs linguist-language=javascript
frontend/**/*.tsx linguist-language=typescript
frontend/**/*.mts linguist-language=typescript
# LFS
*.otf filter=lfs diff=lfs merge=lfs -text
