frontend/.yarn/**            linguist-vendored
frontend/.yarn/releases/*    binary
frontend/.yarn/plugins/**/*  binary
frontend/.pnp.*              binary linguist-generated

# Generated files (typescript)
frontend/**/*.d.ts       linguist-generated gitlab-generated
