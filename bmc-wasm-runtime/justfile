# bmc-wasm-runtime dev tasks. Source of truth for builds is the nix flake
# (`nix build .#wasm-capture`); these recipes are local-iteration shortcuts.
#
# Each recipe is a dumb delegation to a proper tool (cargo, python, mprocs).
# Keep it that way — if a target needs real logic, write a script under
# tools/ and call it from here.
#
# Multi-root: wasm widgets live in `../widgets-wasm-examples/` (SDK examples)
# and `widgets-wasm/` (production widgets). Each widget's workspace root
# is resolved at recipe execution time via `tools/widget_root.py`.

dir := source_directory()
wasm_target := "wasm32-unknown-unknown"
cargo_features := "--features testbed"

# Shared cargo target-dir resolver (repo-level, used by the gallery too).
target_dir_tool := dir + "/../scripts/cargo_target_dir.py"

# Visual regression output (shared across all widget roots).
output_dir := dir + "/captures"

[private]
default:
    @just --justfile {{ source_file() }} --list

# === Build / clean ===

# Remove cargo build artifacts for the host workspace and every widget workspace.
clean:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo clean --manifest-path {{ dir }}/Cargo.toml
    for root in $({{ dir }}/tools/widget_root.py); do
        cargo clean --manifest-path "$root/Cargo.toml"
    done

# === Dev / run ===

# Hot-reload dev: the testbed watches the widget's source and rebuilds it.
dev WIDGET ARGS="": (prebuild WIDGET)
    just --justfile {{ source_file() }} testbed {{ WIDGET }} '{{ ARGS }}'

# The testbed loads the widget's wasm at startup, so both exist up front.
[private]
prebuild WIDGET:
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    name=$({{ dir }}/tools/widget_root.py --dir {{ WIDGET }})
    cargo build {{ cargo_features }} --bin testbed --manifest-path {{ dir }}/Cargo.toml
    cargo build --manifest-path "$root/$name/Cargo.toml" --target {{ wasm_target }}

# Rebuild WIDGET's wasm on source change, for a split that pairs it with
# something else; the testbed rebuilds on its own.
watch WIDGET:
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    name=$({{ dir }}/tools/widget_root.py --dir {{ WIDGET }})
    cd "$root" && exec cargo watch -x "build --manifest-path $name/Cargo.toml --target {{ wasm_target }}"

# Run the debug testbed on WIDGET with its dev blob cache; extra ARGS reach the testbed.
testbed WIDGET ARGS="":
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    name=$({{ dir }}/tools/widget_root.py --dir {{ WIDGET }})
    target=$({{ target_dir_tool }} "$root")
    wasm_file="$target/{{ wasm_target }}/debug/$(echo "$name" | tr - _).wasm"
    # Per-widget dev blob cache at the repo root (git-ignored), easy to find and
    # clear, so history survives a hot rebuild.
    cache_dir="{{ parent_directory(dir) }}/.cache/testbed/$name"
    mkdir -p "$cache_dir"
    exec cargo run {{ cargo_features }} --bin testbed --manifest-path {{ dir }}/Cargo.toml -- "$wasm_file" --widget-root "$root/$name" --cache-dir "$cache_dir" {{ ARGS }}

# Run a release-built widget once in the testbed.
run WIDGET ARGS="":
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    name=$({{ dir }}/tools/widget_root.py --dir {{ WIDGET }})
    target=$({{ target_dir_tool }} "$root")
    wasm_file="$target/{{ wasm_target }}/release/$(echo "$name" | tr - _).wasm"
    cargo build --manifest-path "$root/$name/Cargo.toml" --release --target {{ wasm_target }}
    cargo run {{ cargo_features }} --bin testbed --manifest-path {{ dir }}/Cargo.toml -- "$wasm_file" --widget-root "$root/$name" {{ ARGS }}

# === Profiling / size ===

# Record a perf profile of WIDGET into reports/REPORT. Extra args → perf_record.py.
profile WIDGET REPORT="00-latest" *ARGS:
    {{ dir }}/tools/perf_record.py -e {{ WIDGET }} -r {{ REPORT }} {{ ARGS }}

# Report the built wasm binary size for WIDGET.
size WIDGET:
    {{ dir }}/tools/wasm_size.py -e {{ WIDGET }}

# Fail if WIDGET's wasm binary exceeds the configured size limit.
size-check WIDGET:
    {{ dir }}/tools/wasm_size.py -e {{ WIDGET }} --check

# Re-run every capture fixture and report the observed shadow-stack high-water marks.
stack-profile:
    cd {{ dir }}/.. && nix build -L .#wasm-stack-usage-report

# === Codegen ===

# Regenerate `manifest_params.rs` from `manifest.json`.
gen WIDGET:
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    name=$({{ dir }}/tools/widget_root.py --dir {{ WIDGET }})
    cargo run -p bmc-widget-codegen \
        --manifest-path {{ dir }}/../Cargo.toml -- \
            --manifest "$root/$name/manifest.json" \
            --out "$root/$name/src/manifest_params.rs"

# === Docs ===

# SDK API docs (opens in browser).
docs:
    cargo doc --manifest-path {{ dir }}/sdk/Cargo.toml --target {{ wasm_target }} --no-deps --open

# === Recording ===

# Record a session. TARGET = <platform>:<viewport>; NAME defaults to <platform>-<viewport>; extra args reach the testbed.
record WIDGET TARGET="bmc100:full" NAME="" *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail

    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    name=$({{ dir }}/tools/widget_root.py --dir {{ WIDGET }})
    target=$({{ target_dir_tool }} "$root")

    wasm_file="$target/{{ wasm_target }}/release/$(echo "$name" | tr - _).wasm"
    cargo build --manifest-path "$root/$name/Cargo.toml" --release --target {{ wasm_target }}

    # No --cache-dir: recording stays hermetic so the fixture is reproducible.
    cargo run {{ cargo_features }} --bin testbed --manifest-path {{ dir }}/Cargo.toml -- "$wasm_file" --widget-root "$root/$name" --record={{ TARGET }} {{ if NAME != "" { "--record-name=" + NAME } else { "" } }} {{ ARGS }}

# === Visual regression ===

# Capture a single widget. Extra args go to the capture binary.
capture WIDGET ARGS="":
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- run-all --widget {{ WIDGET }} \
        --workspace "$root" --output-dir {{ output_dir }} {{ ARGS }}

# Capture every widget in every workspace.
capture-all ARGS="":
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- run-all \
        --workspace {{ dir }}/../widgets-wasm-examples \
        --workspace {{ dir }}/../widgets-wasm \
        --output-dir {{ output_dir }} {{ ARGS }}

# Re-capture then update baselines for a widget.
update-baselines WIDGET: (capture WIDGET)
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- set-baseline \
        --capture-dir="$root/{{ WIDGET }}/capture" \
        --output={{ output_dir }}/{{ WIDGET }}

# Verify one widget against baselines.
verify WIDGET:
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- verify --widget {{ WIDGET }} \
        --workspace "$root" --output-dir {{ output_dir }}

# Verify every widget in parallel, across every workspace.
verify-all:
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- verify --parallel \
        --workspace {{ dir }}/../widgets-wasm-examples \
        --workspace {{ dir }}/../widgets-wasm \
        --output-dir {{ output_dir }}

# Preview a capture. Pass TARGET=bmc100:small etc. to filter, or omit for all.
preview WIDGET TARGET="" ARGS="":
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- preview \
        --output={{ output_dir }}/{{ WIDGET }} \
        {{ if TARGET != "" { "--target " + TARGET } else { "" } }} {{ ARGS }}
