# bmc-wasm-runtime dev tasks. Source of truth for builds is the nix flake
# (`nix build .#wasm-capture`); these recipes are local-iteration shortcuts.
#
# Each recipe is a dumb delegation to a proper tool (cargo, python, mprocs).
# Keep it that way — if a target needs real logic, write a script under
# tools/ and call it from here.
#
# Multi-root: wasm widgets live in `examples/` (SDK examples)
# and `widgets-wasm/` (production widgets). Each widget's workspace root
# is resolved at recipe execution time via `tools/widget_root.py`.

dir := source_directory()
wasm_target := "wasm32-unknown-unknown"
cargo_features := "--features testbed"

# Visual regression output (shared across all widget roots).
output_dir := dir + "/captures"

[private]
default:
    @just --justfile {{ justfile() }} --list

# === Build / clean ===

# Remove cargo build artifacts for the host workspace and every widget workspace.
clean:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo clean --manifest-path {{ dir }}/Cargo.toml
    for root in $({{ dir }}/tools/widget_root.py); do
        cargo clean --manifest-path "$root/Cargo.toml"
    done

# === Dev / run ===

# Hot-reload dev: build testbed + widget + run in an mprocs split.
dev WIDGET ARGS="":
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    target=$(cargo metadata --manifest-path "$root/Cargo.toml" --format-version=1 --no-deps \
        | grep -o '"target_directory":"[^"]*"' | cut -d '"' -f 4)
    wasm_file="$target/{{ wasm_target }}/debug/$(echo {{ WIDGET }} | tr - _).wasm"
    cargo build {{ cargo_features }} --bin testbed --manifest-path {{ dir }}/Cargo.toml
    cargo build --manifest-path "$root/Cargo.toml" -p {{ WIDGET }} --target {{ wasm_target }}
    mprocs \
        --names "watch,testbed" \
        "cd '$root' && cargo watch -x 'build -p {{ WIDGET }} --target {{ wasm_target }}'" \
        "cargo run {{ cargo_features }} --bin testbed --manifest-path {{ dir }}/Cargo.toml -- '$wasm_file' {{ ARGS }}"

# Run a release-built widget once in the testbed.
run WIDGET ARGS="":
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    target=$(cargo metadata --manifest-path "$root/Cargo.toml" --format-version=1 --no-deps \
        | grep -o '"target_directory":"[^"]*"' | cut -d '"' -f 4)
    wasm_file="$target/{{ wasm_target }}/release/$(echo {{ WIDGET }} | tr - _).wasm"
    cargo build --manifest-path "$root/Cargo.toml" -p {{ WIDGET }} --release --target {{ wasm_target }}
    cargo run {{ cargo_features }} --bin testbed --manifest-path {{ dir }}/Cargo.toml -- "$wasm_file" {{ ARGS }}

# === Profiling / size ===

# Record a perf profile of WIDGET. Extra args go to perf_record.py.
profile WIDGET ARGS="":
    {{ dir }}/tools/perf_record.py -e {{ WIDGET }} {{ ARGS }}

# Report the built wasm binary size for WIDGET.
size WIDGET:
    {{ dir }}/tools/wasm_size.py -e {{ WIDGET }}

# Fail if WIDGET's wasm binary exceeds the configured size limit.
size-check WIDGET:
    {{ dir }}/tools/wasm_size.py -e {{ WIDGET }} --check

# === Codegen ===

# Regenerate `manifest_params.rs` from `manifest.json`.
gen WIDGET:
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    cargo run -p bmc-widget-codegen \
        --manifest-path {{ dir }}/../Cargo.toml -- \
            --manifest "$root/{{ WIDGET }}/manifest.json" \
            --out "$root/{{ WIDGET }}/src/manifest_params.rs"

# === Docs ===

# SDK API docs (opens in browser).
docs:
    cargo doc --manifest-path {{ dir }}/sdk/Cargo.toml --target {{ wasm_target }} --no-deps --open

# === Recording ===

# Record an interactive session. SIZE = full | small | etc.
record WIDGET SIZE="full":
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    target=$(cargo metadata --manifest-path "$root/Cargo.toml" --format-version=1 --no-deps \
        | grep -o '"target_directory":"[^"]*"' | cut -d '"' -f 4)
    wasm_file="$target/{{ wasm_target }}/release/$(echo {{ WIDGET }} | tr - _).wasm"
    cargo build --manifest-path "$root/Cargo.toml" -p {{ WIDGET }} --release --target {{ wasm_target }}
    cargo run {{ cargo_features }} --bin testbed --manifest-path {{ dir }}/Cargo.toml -- "$wasm_file" --record={{ SIZE }}

# === Visual regression ===

# Capture a single widget. Extra args go to the capture binary.
capture WIDGET ARGS="":
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- run-all -e {{ WIDGET }} \
        --widgets-dir "$root" --output-dir {{ output_dir }} {{ ARGS }}

# Capture every widget in every workspace.
capture-all ARGS="":
    #!/usr/bin/env bash
    set -euo pipefail
    for root in $({{ dir }}/tools/widget_root.py); do
        cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- run-all \
            --widgets-dir "$root" --output-dir {{ output_dir }} {{ ARGS }}
    done

# Re-capture then update baselines for a widget.
update-baselines WIDGET: (capture WIDGET)
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- set-baseline \
        --capture-dir="$root/{{ WIDGET }}/capture" \
        --output={{ output_dir }}/{{ WIDGET }}

# Verify one widget against baselines.
verify WIDGET:
    #!/usr/bin/env bash
    set -euo pipefail
    root=$({{ dir }}/tools/widget_root.py {{ WIDGET }})
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- verify -e {{ WIDGET }} \
        --widgets-dir "$root" --output-dir {{ output_dir }}

# Verify all widgets in parallel, across every workspace.
verify-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for root in $({{ dir }}/tools/widget_root.py); do
        cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- verify --parallel \
            --widgets-dir "$root" --output-dir {{ output_dir }}
    done

# Preview a capture. Pass SIZE=small etc. to filter, or omit for all sizes.
preview WIDGET SIZE="" ARGS="":
    cargo run --features capture --bin capture --manifest-path {{ dir }}/Cargo.toml -- preview \
        --output={{ output_dir }}/{{ WIDGET }} \
        {{ if SIZE != "" { "-s " + SIZE } else { "" } }} {{ ARGS }}
