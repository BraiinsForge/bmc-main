START=91

LOG() {
	logger -t nix-activator "$*"
}

mount_nix() {
	[ -d /mnt/data/nix ] || {
		LOG "no /mnt/data/nix, skipping mount"
		return 1
	}

	mkdir -p /nix
	mount --bind /mnt/data/nix /nix || {
		LOG "mount --bind /mnt/data/nix /nix failed"
		return 1
	}

	return 0
}

find_latest_link() {
	local dir link name n max latest

	dir="$1"
	max=0
	latest=""

	for link in "$dir"/*-link; do
		[ -d "$link" ] || continue
		[ -e "$link" ] || continue
		name="${link##*/}"
		n="${name%-link}"
		case "$n" in
			''|*[!0-9]*) continue ;;
		esac
		if [ "$n" -gt "$max" ]; then
			max=$n
			latest=$link
		fi
	done

	[ -n "$latest" ] && printf '%s\n' "$latest"
}

activate_profile() {
	local profile_dir current bos_version next marker entrypoint failed_generation old_target

	# NIX_ACTIVATOR_PROFILE_DIR and NIX_ACTIVATOR_BOS_VERSION_FILE
	# relocate the inputs for tests.
	profile_dir="${NIX_ACTIVATOR_PROFILE_DIR:-/nix/var/nix/gcroots/profiles/bmc}"
	current="$profile_dir/current"
	bos_version="$(cat "${NIX_ACTIVATOR_BOS_VERSION_FILE:-/etc/bos_version}" 2>/dev/null | tr -d '[:space:]')"

	# The deferred-activation marker carries the BOS version it was
	# staged for in its name: this activator only looks for the marker
	# matching the running firmware, so packages staged for another
	# version — e.g. by a sysupgrade that failed before its reboot —
	# are never activated here. Such markers are stale and removed.
	# Without a known BOS version staleness is undecidable: leave all
	# markers alone and activate 'current' below.
	if [ -n "$bos_version" ]; then
		next="$profile_dir/next.$bos_version"
		for marker in "$profile_dir"/next "$profile_dir"/next.*; do
			[ -L "$marker" ] || continue
			[ "$marker" = "$next" ] && continue
			LOG "removing stale next marker ${marker##*/}"
			rm -f "$marker"
		done

		# The staged generation takes precedence over 'current'. Run its
		# entrypoint with 'current' still naming the previous generation:
		# the entrypoint's final step is the durable 'current' flip, so a
		# crash or failure anytime before it leaves 'current' on the
		# known-good generation with the marker in place for a retry. The
		# entrypoint derives PROFILE_OLD_GENERATION from 'current' itself,
		# so no old generation is passed in. A marker that does not
		# resolve to a generation directory is ignored.
		if [ -L "$next" ] && [ -d "$next" ]; then
			entrypoint="$(readlink -f "$next")/core/activation/entrypoint"
			if [ -x "$entrypoint" ]; then
				old_target="$(readlink "$current" 2>/dev/null)"
				LOG "activating staged next generation"
				if "$entrypoint"; then
					rm -f "$next"
					return 0
				fi
				# The staged entrypoint may have written partial state
				# before failing, including advancing 'current' to the
				# failed generation (its final step is the durable
				# 'current' flip, which can fail after the rename; old
				# generation formats flip 'current' early). Put 'current'
				# back on the snapshotted target so the fallback below
				# re-runs the known-good generation, and remember the
				# failed generation so that fallback passes it as
				# PROFILE_OLD_GENERATION and diff-driven activation
				# scripts undo the side effects it wrote before aborting.
				# Keep the marker for a later retry. The restore needs no
				# directory fsync: a successful fallback re-commits
				# 'current' durably via its own write-boundary step, and
				# after a power loss the kept marker retries the staged
				# generation anyway; the 'sync' is insurance should the
				# fallback also fail.
				failed_generation="$(readlink -f "$next")"
				LOG "next generation activation failed, falling back to current"
				if [ "$(readlink "$current" 2>/dev/null)" != "$old_target" ]; then
					if [ -n "$old_target" ]; then
						LOG "restoring current to $old_target"
						rm -f "$current.tmp" \
							&& ln -s "$old_target" "$current.tmp" \
							&& mv -Tf "$current.tmp" "$current" \
							|| LOG "failed to restore current to $old_target"
					else
						LOG "removing current left by the failed activation"
						rm -f "$current" || LOG "failed to remove current"
					fi
					sync
				fi
			else
				LOG "next generation entrypoint missing or not executable: $entrypoint"
			fi
		fi
	else
		LOG "BOS version unknown; ignoring any staged next markers"
	fi

	# On initial Nix initialization there is no 'current' symlink yet:
	# the old firmware upgrade script only downloads the Nix store, and
	# the first boot on the new firmware picks up 1-link via this fallback.
	if [ ! -L "$current" ]; then
		current="$(find_latest_link "$profile_dir")"
		if [ -z "$current" ]; then
			LOG "no current profile and no generation links, skipping activation"
			return 0
		fi
		LOG "no current profile, falling back to $current"
	fi

	entrypoint="$(readlink -f "$current")/core/activation/entrypoint"
	if [ ! -x "$entrypoint" ]; then
		LOG "activation entrypoint missing or not executable: $entrypoint"
		return 1
	fi

	LOG "running activation entrypoint"
	if [ -n "$failed_generation" ]; then
		# Reconcile the rootfs against the failed generation rather than
		# 'current' itself, matching the bmc-nix CLI revert path.
		PROFILE_OLD_GENERATION="$failed_generation" "$entrypoint" || {
			rc=$?
			LOG "activation failed with exit code $rc"
			return "$rc"
		}
	else
		"$entrypoint" || {
			rc=$?
			LOG "activation failed with exit code $rc"
			return "$rc"
		}
	fi
}

boot() {
	mount_nix || return 0
	activate_profile || true
}
