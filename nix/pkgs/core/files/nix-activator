START=91

LOG() {
	logger -t nix-activator "$*"
}

mount_nix() {
	[ -d /mnt/data/nix ] || {
		LOG "no /mnt/data/nix, skipping mount"
		return 1
	}

	mkdir -p /nix
	mount --bind /mnt/data/nix /nix || {
		LOG "mount --bind /mnt/data/nix /nix failed"
		return 1
	}

	return 0
}

find_latest_link() {
	local dir link name n max latest

	dir="$1"
	max=0
	latest=""

	for link in "$dir"/*-link; do
		[ -d "$link" ] || continue
		name="${link##*/}"
		n="${name%-link}"
		case "$n" in
			''|*[!0-9]*) continue ;;
		esac
		if [ "$n" -gt "$max" ]; then
			max=$n
			latest=$link
		fi
	done

	[ -n "$latest" ] && printf '%s\n' "$latest"
}

activate_profile() {
	local profile_dir current bos_version next marker entrypoint old_target old_generation

	profile_dir="/nix/var/nix/gcroots/profiles/bmc"
	current="$profile_dir/current"
	bos_version="$(cat /etc/bos_version 2>/dev/null | tr -d '[:space:]')"

	# The deferred-activation marker carries the BOS version it was
	# staged for in its name: this activator only looks for the marker
	# matching the running firmware, so packages staged for another
	# version — e.g. by a sysupgrade that failed before its reboot —
	# are never activated here. Such markers are stale and removed.
	# Without a known BOS version staleness is undecidable: leave all
	# markers alone and activate 'current' below.
	if [ -n "$bos_version" ]; then
		next="$profile_dir/next.$bos_version"
		for marker in "$profile_dir"/next "$profile_dir"/next.*; do
			[ -L "$marker" ] || continue
			[ "$marker" = "$next" ] && continue
			LOG "removing stale next marker ${marker##*/}"
			rm -f "$marker"
		done

		# The staged generation takes precedence over 'current':
		# promote it to 'current' before its entrypoint runs so the
		# activated system and the profile agree, consume the symlink
		# only on success, and restore 'current' on failure so the
		# previous generation is activated below instead. A marker
		# that does not resolve to a generation directory is ignored.
		if [ -L "$next" ] && [ -d "$next" ]; then
			entrypoint="$(readlink -f "$next")/core/activation/entrypoint"
			if [ -x "$entrypoint" ]; then
				old_target="$(readlink "$current" 2>/dev/null)"
				# The entrypoint derives PROFILE_OLD_GENERATION from
				# 'current', which is repointed at the new generation
				# below before it runs; pass the pre-promotion
				# generation explicitly so diff-driven activation
				# scripts see the real old one.
				case "$old_target" in
					''|/*) old_generation="$old_target" ;;
					*) old_generation="$profile_dir/$old_target" ;;
				esac
				[ -e "$old_generation" ] || old_generation=""
				# A failed repoint must not run the new generation's
				# entrypoint: 'current' would keep naming the old
				# generation, so activation side effects would apply
				# while the profile disagrees. Keep the marker and
				# fall through to activating 'current' below.
				if ln -sfn "$(readlink "$next")" "$current"; then
					LOG "activating staged next generation"
					if PROFILE_OLD_GENERATION="$old_generation" "$entrypoint"; then
						rm -f "$next"
						return 0
					fi
					LOG "next generation activation failed, reverting to previous"
					if [ -n "$old_target" ]; then
						ln -sfn "$old_target" "$current"
					else
						rm -f "$current"
					fi
				else
					LOG "cannot repoint current at staged generation, skipping it"
					if [ -n "$old_target" ] && ! ln -sfn "$old_target" "$current"; then
						LOG "cannot restore previous current, skipping activation"
						return 1
					fi
				fi
			else
				LOG "next generation entrypoint missing or not executable: $entrypoint"
			fi
		fi
	else
		LOG "BOS version unknown; ignoring any staged next markers"
	fi

	# On initial Nix initialization there is no 'current' symlink yet:
	# the old firmware upgrade script only downloads the Nix store, and
	# the first boot on the new firmware picks up 1-link via this fallback.
	if [ ! -L "$current" ]; then
		current="$(find_latest_link "$profile_dir")"
		if [ -z "$current" ]; then
			LOG "no current profile and no generation links, skipping activation"
			return 0
		fi
		LOG "no current profile, falling back to $current"
	fi

	entrypoint="$(readlink -f "$current")/core/activation/entrypoint"
	if [ ! -x "$entrypoint" ]; then
		LOG "activation entrypoint missing or not executable: $entrypoint"
		return 1
	fi

	LOG "running activation entrypoint"
	"$entrypoint"
}

boot() {
	mount_nix || return 0
	activate_profile || true
}
