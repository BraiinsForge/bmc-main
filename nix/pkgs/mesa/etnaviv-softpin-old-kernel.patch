+/* Softpin relies on the kernel reaping idle mappings that block a requested
+ * address (Linux 2829a9fcb738, 5.19). Without that, a buffer freed here but
+ * still held by another process, such as an exported DMA-BUF, keeps its GPU
+ * mapping, and reusing its address fails the submit with ENOSPC. Older
+ * kernels place buffers themselves and reap idle mappings as needed.
+ */
+static bool kernel_reaps_softpin_mappings(void)
+{
+	struct utsname u;
+	unsigned major, minor;
+
+	if (uname(&u) || sscanf(u.release, "%u.%u", &major, &minor) != 2)
+		return true;
+
+	return major > 5 || (major == 5 && minor >= 19);
+}
