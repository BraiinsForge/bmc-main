export component FemtoVgDemo inherits Window {
    // Main ball
    in property <float> ball-x: 160;
    in property <float> ball-y: 60;

    // FPS display
    in property <int> fps: 0;

    background: #0a0a1a;

    // Main bouncing ball
    Rectangle {
        x: ball-x * 1px - 20px;
        y: ball-y * 1px - 20px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: white;
    }

    // FPS counter
    Rectangle {
        x: parent.width - 80px;
        y: 0;
        width: 80px;
        height: 30px;
        background: #00000080;

        Text {
            x: 10px;
            y: 6px;
            text: fps + " FPS";
            color: fps >= 55 ? #00ff00 : (fps >= 30 ? #ffff00 : #ff0000);
            font-size: 14px;
            font-weight: 700;
        }
    }
}
