# Browsers for driving the device's web UI, and a walk through it.

import '../common.justfile'

set working-directory := '..'
set positional-arguments

# Print the nixpkgs browsers web-probe runs, for `PLAYWRIGHT_BROWSERS_PATH`.
browsers:
    @nix build --no-link --print-out-paths .#web-probe-browsers

# Walk the web UI at ORIGIN, shooting every page and tab into `.tmp/web-probe`, in `--language TAG` if given.
walk ORIGIN *ARGS:
    PLAYWRIGHT_BROWSERS_PATH="$(just --justfile {{ quote(source_file()) }} browsers)" {{ NIX_DEV }} uv run python -u -m web_probe "$@"
