# Frontend dev tasks (pnpm-driven). Source of truth for builds is the nix
# flake (`nix build .#frontend`); these recipes mirror what runs in CI and
# what's useful during local iteration.

import '../common.justfile'

# Enable Slint live-preview across all recipes that spawn the mock backend.
export SLINT_LIVE_PREVIEW := "1"

# `source_directory()`, not `justfile_directory()`:
# under `just fe::…` the latter is the root justfile's directory,
# so every path below would climb one too far.
dir := source_directory()

# Fail unless the pnpm on PATH has the major that package.json declares.
[private]
check-pnpm:
    @node {{ dir }}/bin/check-pnpm.mjs

# === QA ===

# Auto-format JS/TS/SCSS sources.
format: check-pnpm
    pnpm exec biome migrate --write
    pnpm exec biome format --write .
    pnpm exec prettier './**/*.scss' --log-level=warn --write

# Static analysis (biome + stylelint).
lint: check-pnpm
    pnpm exec biome check --max-diagnostics=100 .
    pnpm exec stylelint '**/*.scss' --color --quiet --formatter string --allow-empty-input --config stylelint.config.cjs

# Type-check + run unit tests.
test: check-pnpm
    pnpm exec tsc --diagnostics --pretty --project ./tsconfig.json
    pnpm exec rstest run

# Full validation: format + lint + test.
validate: format lint test

# === Build ===

# Production build (dist/).
build: check-pnpm
    pnpm exec rsbuild build

# === Dev ===

# Frontend dev server (rsbuild watch).
dev: check-pnpm
    pnpm exec rsbuild dev

# Build the native widget bundle bmc-mock serves as installable widgets.
[private]
build-widgets:
    cd {{ dir }}/.. && nix build .#widgets --out-link result-widgets

# Run mock backend against this frontend's built dist (`build` first),
# with the language packs the device profile ships.
serve EXTRA_ARGS="": build-widgets
    cd {{ dir }}/.. && BMC_LANGUAGES_PATH="{{ dir }}/../assets/intl/profile-languages" cargo run \
        --package bmc-mock -- \
        --address="0.0.0.0:6070" \
        --system-password="root" \
        --www-path="{{ dir }}/dist" \
        --sounds-dir="{{ dir }}/@data/sounds" \
        --widgets-path="{{ dir }}/../result-widgets/lib/bmc-widgets" \
        --mockfs-path="{{ dir }}/@data/mockfs" {{ EXTRA_ARGS }}

# Same as `serve`, but force factory defaults on boot.
serve-factory:
    @just serve --factory-default

# Like `serve`, but restart the mock after simulated firmware-upgrade reboots.
serve-loop:
    while true; do just serve; echo "mock exited - restarting (simulated reboot)"; sleep 2; done

# Storybook (component sandbox).
storybook-start: check-pnpm
    pnpm exec storybook dev \
        --no-open \
        --port=6005 \
        --exact-port \
        --disable-telemetry

# === Image optimization ===

# Minify SVG files under ./src using the installed svgo defaults.
minify-svg: check-pnpm
    pnpm exec svgo --recursive --folder ./src

# === Nix integration ===

# Refresh the pnpm deps hash.
nix-update-hash: check-pnpm
    ./bin/nix-update-hash.ts
