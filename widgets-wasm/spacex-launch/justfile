# SpaceX Launch dev tasks: `just widgets::spacex-launch::dev`,
# or bare `just dev` from this directory. Generic mechanics delegate
# to the wasm module; this file owns only the Nexus scenarios and their wiring.

import '../../common.justfile'

dir := source_directory()
repo := parent_directory(parent_directory(dir))
root_justfile := repo / "justfile"

# Widget + sim + watch in mprocs. SCENARIO: healthy, warming, failed, outage, imminent, starship, crew-dragon, rideshare, launched.
dev SCENARIO="healthy":
    @just --justfile {{ root_justfile }} wasm::prebuild spacex-launch
    mprocs \
        --names "netsim,watch,testbed:{{ SCENARIO }}" \
        "just --justfile {{ source_file() }} run-netsim" \
        "just --justfile {{ root_justfile }} wasm::watch spacex-launch" \
        "just --justfile {{ source_file() }} run-testbed {{ SCENARIO }}"

# Serve every simulator scenario at once, one port each.
run-netsim:
    @just --justfile {{ root_justfile }} netsim::run {{ dir }}/sim-blueprint.json5

# The testbed flag aiming a run at SCENARIO's simulated deployment.
[private]
sim-args SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    case "{{ SCENARIO }}" in
        healthy)     port=20600 ;;
        warming)     port=20601 ;;
        failed)      port=20602 ;;
        outage)      port=20603 ;;
        imminent)    port=20604 ;;
        starship)    port=20605 ;;
        crew-dragon) port=20606 ;;
        rideshare)   port=20607 ;;
        launched)    port=20608 ;;
        *)
            echo "unknown scenario '{{ SCENARIO }}' (healthy | warming | failed | outage |" \
                 "imminent | starship | crew-dragon | rideshare | launched)" >&2
            exit 1
            ;;
    esac

    echo "--rewrite-url https://nexus.braiinsforge.com=http://127.0.0.1:$port"

# Testbed against SCENARIO's simulated deployment; needs `run-netsim` serving.
[private]
run-testbed SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})
    # Its own cache bucket, so scenarios running side by side never collide.
    exec just --justfile {{ root_justfile }} wasm::testbed spacex-launch "$args" {{ SCENARIO }}

# Render gallery scenes headlessly; NAME picks one recipe, default all.
capture NAME="*":
    @just --justfile {{ root_justfile }} wasm::scenes spacex-launch "{{ NAME }}"

# Record TARGET's capture fixture against SCENARIO; needs `run-netsim` already serving.
record SCENARIO TARGET="bmc100:full":
    #!/usr/bin/env bash
    set -euo pipefail

    # Bind first so a failed substitution cannot record against the live API.
    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})

    # The dataset name carries the scenario, so one take cannot overwrite another's at the same target.
    exec just --justfile {{ root_justfile }} wasm::record spacex-launch \
        --record={{ TARGET }} --record-name={{ replace(TARGET, ":", "-") + "-" + SCENARIO }} $args
