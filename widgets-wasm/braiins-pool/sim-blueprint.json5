{
  "$schema": "../../bmc-netsim/blueprint.schema.json",

  // Braiins Pool accounts for the braiins-pool widget.
  // Cloud APIs: nothing is announced — the testbed reaches a pinned port
  // through `--rewrite-url` (the justfile's scenario map names these same ports).
  instances: [
    {
        device: "braiins-pool",
        label: "Healthy FPPS account — daily payouts, ~500 TH/s",
        port: 20000,
    },
    {
        device: "braiins-pool",
        label: "Idle account — zeros everywhere, no payout ever",
        port: 20001,
        params: {
            hashrate_ths: 0,
            workers_active: 0,
            workers_low: 0,
            workers_offline: 0,
            reward_btc: 0,
            reward_usd: 0,
            payout_period_s: null,
        },
    },
    {
        device: "braiins-pool",
        label: "Denied account — the API refuses the key",
        port: 20002,
        params: { status: 403 },
    },
  ],
}
