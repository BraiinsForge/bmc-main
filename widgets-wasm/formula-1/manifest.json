{
  "$schema": "../../bmc-widget-manifest/manifest.schema.json",
  "uid": "20326ae9-741c-4374-b322-b91ad377a0a3",
  "version": "0.1.0",
  "name": "Formula 1",
  "description": "Formula 1 championship standings, driver stats, race info, and live timing",
  "author": {
    "name": "Braiins Forge",
    "url": "https://braiinsforge.com"
  },
  "binary": "bin/formula-1",
  "icon": "assets/icon.svg",
  "category": "sports",
  "settings": [
    "localization",
    "timezone"
  ],
  "supported_viewports": [
    {
      "type": "rectangular",
      "min_width": 317,
      "max_width": 1280,
      "min_height": 238,
      "max_height": 480
    }
  ],
  "params": {
    "view": {
      "name": "Type of widget",
      "description": "Automatic shows the live session while one is on, otherwise the next race, otherwise the standings",
      "type": "string",
      "default_value": "auto",
      "enum_values": [
        {
          "value": "auto",
          "label": "Automatic (live session, next race, or standings)"
        },
        {
          "value": "next_race",
          "label": "Next Race"
        },
        {
          "value": "standings",
          "label": "Driver Standings"
        },
        {
          "value": "driver",
          "label": "Driver Statistics"
        }
      ]
    },
    "local_time": {
      "name": "Use my local time",
      "description": "Show session times in your timezone instead of the circuit's",
      "type": "boolean",
      "default_value": false
    },
    "driver": {
      "name": "Driver",
      "description": "Driver shown in the Driver Statistics view",
      "type": "string",
