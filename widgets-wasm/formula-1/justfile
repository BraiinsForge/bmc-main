# Formula 1 dev tasks: `just widgets::formula-1::dev`, or bare `just dev`
# from this directory. Generic mechanics (builds, watch, testbed) delegate to
# the wasm module; this file owns only the sim scenarios and their wiring.

import '../../common.justfile'

dir := source_directory()
repo := parent_directory(parent_directory(dir))
root_justfile := repo / "justfile"

# Widget + sim + watch in mprocs. SCENARIO: race, sprint, quali, practice, idle, off-season, cold-start, warming, race-eve, stale.
dev SCENARIO="race":
    @just --justfile {{ root_justfile }} wasm::prebuild formula-1
    mprocs \
        --names "netsim,watch,testbed:{{ SCENARIO }}" \
        "just --justfile {{ source_file() }} run-netsim" \
        "just --justfile {{ root_justfile }} wasm::watch formula-1" \
        "just --justfile {{ source_file() }} run-testbed {{ SCENARIO }}"

# Serve the sim deployments — every scenario at once, one port each.
run-netsim:
    @just --justfile {{ root_justfile }} netsim::run {{ dir }}/sim-blueprint.json5

# The testbed flag aiming a run at SCENARIO's simulated deployment.
[private]
sim-args SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    case "{{ SCENARIO }}" in
        race)       port=20100 ;;
        quali)      port=20101 ;;
        practice)   port=20102 ;;
        idle)       port=20103 ;;
        off-season) port=20104 ;;
        cold-start) port=20105 ;;
        stale)      port=20106 ;;
        sprint)     port=20107 ;;
        warming)    port=20108 ;;
        race-eve)   port=20109 ;;
        *)
            echo "unknown scenario '{{ SCENARIO }}' (race | sprint | quali | practice |" \
                 "idle | off-season | cold-start | warming | race-eve | stale)" >&2
            exit 1
            ;;
    esac

    echo "--rewrite-url https://nexus.braiinsforge.com=http://127.0.0.1:$port"

# Testbed against SCENARIO's simulated deployment; needs `run-netsim` serving.
[private]
run-testbed SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})
    # Its own cache bucket, so scenarios running side by side never collide.
    exec just --justfile {{ root_justfile }} wasm::testbed formula-1 "$args" {{ SCENARIO }}

# Render the gallery scenes headlessly; NAME picks one recipe, default all.
capture NAME="*":
    #!/usr/bin/env bash
    set -euo pipefail

    # A relative `--capture` resolves against the gallery's own directory
    # rather than this one, so the path goes in absolute.
    #
    # Software GL by default, unlike the gallery's window:
    # llvmpipe and a GPU rasterise differently,
    # so two machines' shots compare only when both pin the same rasteriser.
    # Set it to 0 for the machine's own driver.
    export GALLERY_SOFTWARE_GL="${GALLERY_SOFTWARE_GL:-1}"

    shopt -s nullglob
    recipes=({{ dir }}/gallery/{{ NAME }}.capture.toml)
    if [ ${#recipes[@]} -eq 0 ]; then
        echo "no capture recipe '{{ NAME }}' in {{ dir }}/gallery" >&2
        exit 1
    fi

    for recipe in "${recipes[@]}"; do
        name=$(basename "$recipe" .capture.toml)
        just --justfile {{ root_justfile }} gallery::capture "$recipe" "f1-$name"
    done

# Testbed on SCENARIO (see `dev`), ready to record; needs `run-netsim` serving.
record SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    # Bound to a variable, not inlined: a failed substitution inside the exec's
    # arguments would leave `set -e` satisfied and record against the live API.
    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})

    exec just --justfile {{ root_justfile }} wasm::record formula-1 $args
