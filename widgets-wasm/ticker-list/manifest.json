{
  "$schema": "../../bmc-widget-manifest/manifest.schema.json",
  "uid": "51f48290-a8fd-466d-8693-1911b06c68c8",
  "version": "0.1.0",
  "name": "Financial Ticker List",
  "description": "Display multiple financial symbols with prices, changes, and sparkline charts",
  "author": {
    "name": "Braiins Forge",
    "url": "https://braiinsforge.com"
  },
  "binary": "bin/ticker-list",
  "settings": [
    "localization"
  ],
  "supported_viewports": [
    {
      "type": "rectangular",
      "min_width": 317,
      "max_width": 1280,
      "min_height": 238,
      "max_height": 480
    }
  ],
  "params": {
    "symbols": {
      "name": "Symbols",
      "description": "JSON array of 1-8 financial symbols, stock tickers, or cryptocurrency pairs to display",
      "type": "string",
      "default_value": "[\"NVDA\",\"AAPL\",\"TSLA\",\"MSTR\",\"JPM\",\"META\",\"SPY\",\"NFLX\"]"
    },
    "period": {
      "name": "Time Period",
      "description": "Time period for the chart and the price change",
      "type": "string",
      "default_value": "7d",
      "enum_values": [
        {
          "value": "1d",
          "label": "1 Day"
        },
        {
          "value": "7d",
          "label": "7 Days"
        },
        {
          "value": "30d",
          "label": "30 Days"
        }
      ]
    }
  }
}
