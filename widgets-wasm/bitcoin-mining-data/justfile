# Bitcoin Mining Data dev tasks: `just widgets::bitcoin-mining-data::dev`, or
# bare `just dev` from this directory. Generic mechanics delegate to the wasm
# module; this file owns only the Nexus scenarios and their wiring.

import '../../common.justfile'

dir := source_directory()
repo := parent_directory(parent_directory(dir))
root_justfile := repo / "justfile"

# Widget + sim + watch in mprocs. SCENARIO: healthy, warming, failed, stale, rate-limited, extremes.
dev SCENARIO="healthy":
    @just --justfile {{ root_justfile }} wasm::prebuild bitcoin-mining-data
    mprocs \
        --names "netsim,watch,testbed:{{ SCENARIO }}" \
        "just --justfile {{ source_file() }} run-netsim" \
        "just --justfile {{ root_justfile }} wasm::watch bitcoin-mining-data" \
        "just --justfile {{ source_file() }} run-testbed {{ SCENARIO }}"

# Serve every simulator scenario at once, one port each.
run-netsim:
    @just --justfile {{ root_justfile }} netsim::run {{ dir }}/sim-blueprint.json5

# The testbed flag aiming a run at SCENARIO's simulated deployment.
[private]
sim-args SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    case "{{ SCENARIO }}" in
        healthy)      port=20200 ;;
        warming)      port=20201 ;;
        failed)       port=20202 ;;
        stale)        port=20203 ;;
        rate-limited) port=20204 ;;
        extremes)     port=20205 ;;
        *)
            echo "unknown scenario '{{ SCENARIO }}' (healthy | warming | failed |" \
                 "stale | rate-limited | extremes)" >&2
            exit 1
            ;;
    esac

    echo "--rewrite-url https://nexus.braiinsforge.com=http://127.0.0.1:$port"

# Testbed against SCENARIO's simulated deployment; needs `run-netsim` serving.
[private]
run-testbed SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})
    # Its own cache bucket, so scenarios running side by side never collide.
    exec just --justfile {{ root_justfile }} wasm::testbed bitcoin-mining-data "$args" {{ SCENARIO }}

# Render gallery scenes headlessly; NAME picks one recipe, default all.
capture NAME="*":
    #!/usr/bin/env bash
    set -euo pipefail

    # A relative capture path resolves against the gallery directory, so use an absolute one.
    # Software GL keeps captures comparable across machines; set it to 0 for the local driver.
    export GALLERY_SOFTWARE_GL="${GALLERY_SOFTWARE_GL:-1}"

    shopt -s nullglob
    recipes=({{ dir }}/gallery/{{ NAME }}.capture.toml)
    if [ ${#recipes[@]} -eq 0 ]; then
        echo "no capture recipe '{{ NAME }}' in {{ dir }}/gallery" >&2
        exit 1
    fi

    for recipe in "${recipes[@]}"; do
        name=$(basename "$recipe" .capture.toml)
        just --justfile {{ root_justfile }} gallery::capture "$recipe" "$name"
    done

# Testbed on SCENARIO, ready to record; needs `run-netsim` serving.
record SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    # Bind first so a failed substitution cannot record against the live API.
    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})
    exec just --justfile {{ root_justfile }} wasm::record bitcoin-mining-data $args
