{
  "$schema": "../../bmc-netsim/blueprint.schema.json",

  // Two halves on one port block, split by the gap at 20314: miners below it, the cloud API above.
  // A miner scenario is chosen by editing `miner_url`, even mid-recording, which mints a frame
  // for the state it lands in; the public base URL is compiled in, so its scenario is picked
  // at launch by the `record` recipe's `--rewrite-url`.
  //
  // The unreachable miner needs no entry:
  // point `miner_url` at any port nothing is serving.
  instances: [
    {
      device: "bos",
      label: "Healthy miner, hashing at its tuner target",
      port: 20310,
    },
    {
      device: "bos",
      label: "Underclocked — below the tuned target",
      port: 20311,
      params: { hashrate_ths: 0.8 },
    },
    {
      device: "bos",
      label: "Running 423d 12h 25m — the design's own figure, the widest the row has to fit",
      port: 20312,
      params: { uptime_s: 36591900 },
    },
    {
      device: "bos",
      label: "Auth refused — the password is wrong",
      port: 20313,
      params: { auth_status: 401 },
    },
    {
      device: "braiins-public-api",
      label: "Live BTC price",
      port: 20315,
    },
    {
      device: "braiins-public-api",
      label: "Price unavailable — the miner rows must stay live without it",
      port: 20316,
      params: { status: 503 },
    },
  ],
}
