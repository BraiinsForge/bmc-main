# Miner Info - Geek dev tasks: `just widgets::miner-info-geek::dev`, or bare
# `just dev` from this directory. Generic mechanics delegate to the wasm module;
# this file owns only the public-API scenarios and their wiring.

import '../../common.justfile'

dir := source_directory()
repo := parent_directory(parent_directory(dir))
root_justfile := repo / "justfile"

# Widget + sim + watch in mprocs. SCENARIO picks the public API: healthy, public-down.
dev SCENARIO="healthy":
    @just --justfile {{ root_justfile }} wasm::prebuild miner-info-geek
    mprocs \
        --names "netsim,watch,testbed:{{ SCENARIO }}" \
        "just --justfile {{ source_file() }} run-netsim" \
        "just --justfile {{ root_justfile }} wasm::watch miner-info-geek" \
        "just --justfile {{ source_file() }} run-testbed {{ SCENARIO }}"

# Serve every simulated miner and both public-API scenarios at once, one port each.
run-netsim:
    @just --justfile {{ root_justfile }} netsim::run {{ dir }}/sim-blueprint.json5

# The testbed flag aiming a run at SCENARIO's simulated public API.
[private]
sim-args SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    case "{{ SCENARIO }}" in
        healthy)     port=20315 ;;
        public-down) port=20316 ;;
        *)
            echo "unknown scenario '{{ SCENARIO }}' (healthy | public-down)" >&2
            exit 1
            ;;
    esac

    echo "--rewrite-url https://public-api.braiins.com=http://127.0.0.1:$port"

# Testbed against SCENARIO's simulated public API; needs `run-netsim` serving.
[private]
run-testbed SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})
    # Its own cache bucket, so scenarios running side by side never collide.
    exec just --justfile {{ root_justfile }} wasm::testbed miner-info-geek "$args" {{ SCENARIO }}

# Testbed on SCENARIO's public API, ready to record; needs `run-netsim` serving.
record SCENARIO="healthy":
    #!/usr/bin/env bash
    set -euo pipefail

    # Bind first so a failed substitution cannot record against the live API.
    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})
    exec just --justfile {{ root_justfile }} wasm::record miner-info-geek $args
