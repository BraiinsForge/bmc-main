{
  "$schema": "../../bmc-widget-manifest/manifest.schema.json",
  "uid": "69ed377c-701b-4cdb-b4b6-0308cfe56b64",
  "version": "0.1.0",
  "name": "Ticker - Single Sparkline",
  "description": "Visualize stock, asset, and crypto prices on a single sparkline chart",
  "author": {
    "name": "Braiins Forge",
    "url": "https://braiinsforge.com"
  },
  "binary": "bin/ticker-single-sparkline",
  "settings": [
    "localization"
  ],
  "supported_viewports": [
    {
      "type": "rectangular",
      "min_width": 317,
      "max_width": 1280,
      "min_height": 238,
      "max_height": 480
    }
  ],
  "params": {
    "pair": {
      "name": "Symbol",
      "description": "Financial symbol, stock ticker, or cryptocurrency pair to display",
      "type": "string",
      "default_value": "BTC-USD"
    },
    "period": {
      "name": "Time Period",
      "description": "Time period for the chart and the price change",
      "type": "string",
      "default_value": "7d",
      "enum_values": [
        {
          "value": "1h",
          "label": "1 Hour"
        },
        {
          "value": "3h",
          "label": "3 Hours"
        },
        {
          "value": "6h",
          "label": "6 Hours"
        },
        {
          "value": "12h",
          "label": "12 Hours"
        },
        {
          "value": "1d",
          "label": "1 Day"
        },
        {
          "value": "3d",
          "label": "3 Days"
        },
        {
          "value": "7d",
          "label": "7 Days"
        },
        {
          "value": "14d",
          "label": "14 Days"
        },
        {
          "value": "1mo",
          "label": "1 Month"
        },
        {
          "value": "3mo",
          "label": "3 Months"
        },
        {
          "value": "6mo",
          "label": "6 Months"
        },
        {
          "value": "9mo",
          "label": "9 Months"
        },
        {
          "value": "1Y",
          "label": "1 Year"
        },
        {
          "value": "2Y",
          "label": "2 Years"
        },
        {
          "value": "3Y",
          "label": "3 Years"
        },
        {
          "value": "5Y",
          "label": "5 Years"
        },
        {
          "value": "10Y",
          "label": "10 Years"
        },
        {
          "value": "25Y",
          "label": "25 Years"
        },
        {
          "value": "full",
          "label": "All Time"
        }
      ]
    }
  }
}
