{
  "$schema": "../../bmc-widget-manifest/manifest.schema.json",
  "uid": "6d0c6a2d-24d0-4384-8f8b-6f4ac2c9675a",
  "version": "0.1.0",
  "name": "Mining Info",
  "description": "Mining and Bitcoin network dashboard for Bitcoin miner devices",
  "author": {
    "name": "Braiins Forge",
    "url": "https://braiinsforge.com"
  },
  "binary": "bin/mining-info",
  "icon": "assets/icon.svg",
  "category": "mining",
  "settings": [
    "localization"
  ],
  "supported_viewports": [
    {
      "type": "rectangular",
      "min_width": 320,
      "max_width": 1280,
      "min_height": 240,
      "max_height": 480
    },
    {
      "type": "round",
      "min_width": 480,
      "max_width": 480,
      "min_height": 480,
      "max_height": 480
    }
  ],
  "params": {
    "view": {
      "name": "View",
      "description": "Mining dashboard view to display",
      "type": "string",
      "default_value": "mining",
      "enum_values": [
        {
          "value": "mining",
          "label": "Mining"
        },
        {
          "value": "geek",
          "label": "Geek"
        },
        {
          "value": "info_overload",
          "label": "Info Overload"
        }
      ]
    },
    "miner_url": {
      "name": "Miner URL",
      "description": "Base BOS REST API URL for the miner",
      "type": "string",
      "format": "uri",
      "default_value": "http://localhost/api/v1"
    },
    "miner_password": {
      "name": "Miner password",
      "description": "Password for root login. This is stored as normal widget text until secret params exist.",
      "type": "string",
      "default_value": "root"
    }
  }
}
