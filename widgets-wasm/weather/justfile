# Weather dev tasks: `just widgets::weather::dev`,
# or bare `just dev` from this directory. Generic mechanics delegate
# to the wasm module; this file owns only the Nexus scenarios and their wiring.

import '../../common.justfile'

dir := source_directory()
repo := parent_directory(parent_directory(dir))
root_justfile := repo / "justfile"

# Widget + sim + watch in mprocs. SCENARIO: healthy, warming, location-not-found, failed, stale, frost.
dev SCENARIO="healthy":
    @just --justfile {{ root_justfile }} wasm::prebuild weather
    mprocs \
        --names "netsim,watch,testbed:{{ SCENARIO }}" \
        "just --justfile {{ source_file() }} run-netsim" \
        "just --justfile {{ root_justfile }} wasm::watch weather" \
        "just --justfile {{ source_file() }} run-testbed {{ SCENARIO }}"

# Serve every simulator scenario at once, one port each.
run-netsim:
    @just --justfile {{ root_justfile }} netsim::run {{ dir }}/sim-blueprint.json5

# The testbed flag aiming a run at SCENARIO's simulated deployment.
[private]
sim-args SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    case "{{ SCENARIO }}" in
        healthy)            port=20500 ;;
        warming)            port=20501 ;;
        location-not-found) port=20502 ;;
        failed)             port=20503 ;;
        stale)              port=20504 ;;
        frost)              port=20505 ;;
        *)
            echo "unknown scenario '{{ SCENARIO }}' (healthy | warming |" \
                 "location-not-found | failed | stale | frost)" >&2
            exit 1
            ;;
    esac

    echo "--rewrite-url https://nexus.braiinsforge.com=http://127.0.0.1:$port"

# Testbed against SCENARIO's simulated deployment; needs `run-netsim` serving.
[private]
run-testbed SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})
    # Its own cache bucket, so scenarios running side by side never collide.
    exec just --justfile {{ root_justfile }} wasm::testbed weather "$args" {{ SCENARIO }}

# Render gallery scenes headlessly; NAME picks one recipe, default all.
capture NAME="*":
    @just --justfile {{ root_justfile }} wasm::scenes weather "{{ NAME }}"

# Testbed on SCENARIO, ready to record; needs `run-netsim` serving.
record SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail

    # Bind first so a failed substitution cannot record against the live API.
    args=$(just --justfile {{ source_file() }} sim-args {{ SCENARIO }})
    exec just --justfile {{ root_justfile }} wasm::record weather $args
